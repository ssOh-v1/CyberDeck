#!/usr/bin/python3
import os, json, subprocess

PROTECTED = ("steam", "discord", "vesktop", "legcord", "equibop", "webcord")

try:
    win = json.loads(subprocess.check_output(["hyprctl", "activewindow", "-j"], text=True, stderr=subprocess.DEVNULL))
except Exception:
    win = {}

addr = win.get("address", "")
if not addr:
    raise SystemExit(0)

cls = (win.get("class") or win.get("initialClass") or "").lower()
title = win.get("title") or cls or "App"

# Если это главное окно Steam или Discord — прячем в фон special:bg, не закрывая процесс!
if any(p == cls or cls.startswith(p) for p in PROTECTED) and not cls.startswith("steam_app_"):
    subprocess.run(["hyprctl", "dispatch", "movetoworkspacesilent", f"special:bg,address:{addr}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.Popen([
        "notify-send", "-a", "cyber-kb",
        f"◈ СКРЫТО В ФОН // {cls.upper()}",
        "Приложение продолжает работу. Откройте его через кнопку «◈ Фон» или SUPER+1/2."
    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
else:
    subprocess.run(["hyprctl", "dispatch", "killactive"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
