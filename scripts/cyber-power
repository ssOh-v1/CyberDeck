#!/bin/bash
unset LD_PRELOAD
ACT="${1:-get}"
CUR="balanced"
[ -f /run/cyberdeck-power-mode ] && CUR=$(cat /run/cyberdeck-power-mode 2>/dev/null)

if [ "$ACT" = "get" ]; then
    echo "$CUR"
    exit 0
fi

if [ "$ACT" = "menu" ]; then
    CHOICE=$(printf "󰾆  Эконом (Максимальное энергосбережение, без Turbo Boost)\n󰗑  Баланс (Оптимальный режим для кода и повседневной работы)\n󰓅  Производительность (Максимальные частоты CPU/GPU для игр)" | rofi -dmenu -i -p "⚡ РЕЖИМ ПИТАНИЯ" -theme ~/.config/hypr/cyber_wifi.rasi)
    case "$CHOICE" in
        *Эконом*) TARGET="eco" ;;
        *Баланс*) TARGET="balanced" ;;
        *Производительность*) TARGET="performance" ;;
        *) exit 0 ;;
    esac
    NOTIFY=1
elif [ "$ACT" = "toggle" ]; then
    case "$CUR" in
        eco)         TARGET="balanced" ;;
        balanced)    TARGET="performance" ;;
        performance) TARGET="eco" ;;
        *)           TARGET="balanced" ;;
    esac
    NOTIFY=1
else
    TARGET="$ACT"
    NOTIFY=0
fi

SAVED_BRI=$(brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d '%')
sudo -n /usr/local/bin/cyber-power-hw "$TARGET"
[ -n "$SAVED_BRI" ] && brightnessctl -q set "${SAVED_BRI}%" 2>/dev/null || true

if [ "$NOTIFY" = "1" ]; then
    case "$TARGET" in
        eco)         notify-send -a cyber-kb "󰾆 ПИТАНИЕ // ЭКОНОМ" "Максимальное энергосбережение (Turbo Boost отключён)" ;;
        balanced)    notify-send -a cyber-kb "󰗑 ПИТАНИЕ // БАЛАНС" "Сбалансированный профиль для работы и мультимедиа" ;;
        performance) notify-send -a cyber-kb "󰓅 ПИТАНИЕ // ПРОИЗВОДИТЕЛЬНОСТЬ" "Максимальные частоты CPU/GPU для игр и компиляции" ;;
    esac
fi
