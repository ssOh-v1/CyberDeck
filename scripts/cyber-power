#!/bin/bash
unset LD_PRELOAD
ACT="${1:-get}"
CUR="eco"
[ -f /run/cyberdeck-power-mode ] && CUR=$(cat /run/cyberdeck-power-mode 2>/dev/null)
[ "$CUR" != "performance" ] && CUR="eco"

if [ "$ACT" = "get" ]; then
    echo "$CUR"
    exit 0
fi

if [ "$ACT" = "toggle" ]; then
    if [ "$CUR" = "performance" ]; then TARGET="eco"; else TARGET="performance"; fi
    NOTIFY=1
else
    [ "$ACT" = "performance" ] && TARGET="performance" || TARGET="eco"
    NOTIFY=0
fi

# Сохраняем текущий уровень подсветки перед сменой профиля
SAVED_BRI=$(brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d '%')
sudo -n /usr/local/bin/cyber-power-hw "$TARGET"
[ -n "$SAVED_BRI" ] && brightnessctl -q set "${SAVED_BRI}%" 2>/dev/null || true

if [ "$TARGET" = "performance" ]; then
    hyprctl --batch "keyword decoration:blur:enabled false ; keyword decoration:shadow:enabled false" >/dev/null 2>&1 || true
    [ "$NOTIFY" = "1" ] && notify-send -i "$HOME/.config/hypr/assets/ui/turbo.svg" "◈ ПИТАНИЕ // ПЕРФОМАНС" "Активен игровой профиль CPU/GPU и фиксированный кадр"
else
    [ "$NOTIFY" = "1" ] && notify-send -i "$HOME/.config/hypr/assets/ui/eco.svg" "◈ ПИТАНИЕ // ЭКО" "Энергосберегающий режим активен (яркость сохранена)"
fi
