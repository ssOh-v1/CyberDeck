#!/usr/bin/python3
import os, json

mode = "balanced"
if os.path.isfile("/run/cyberdeck-power-mode"):
    try:
        mode = open("/run/cyberdeck-power-mode", "r", encoding="utf-8").read().strip()
    except Exception:
        mode = "balanced"

if mode == "eco":
    out = {
        "text": "󰾆 ЭКОНОМ",
        "class": "eco",
        "tooltip": "Режим: Эконом (максимальное энергосбережение)\nЛКМ: следующий режим • ПКМ: меню выбора"
    }
elif mode == "performance":
    out = {
        "text": "󰓅 ПРОИЗВ",
        "class": "perf",
        "tooltip": "Режим: Производительность (максимум CPU/GPU для игр и работы)\nЛКМ: следующий режим • ПКМ: меню выбора"
    }
else:
    out = {
        "text": "󰗑 БАЛАНС",
        "class": "bal",
        "tooltip": "Режим: Баланс (оптимальный профиль для работы)\nЛКМ: следующий режим • ПКМ: меню выбора"
    }

print(json.dumps(out, ensure_ascii=False))
