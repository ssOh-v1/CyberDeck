#!/bin/bash
MODE="eco"
[ -f /run/cyberdeck-power-mode ] && MODE=$(cat /run/cyberdeck-power-mode 2>/dev/null)
if [ "$MODE" = "performance" ]; then
    printf '{"text": "󰓅 PERF", "class": "perf", "tooltip": "Режим: Перфоманс (ЛКМ — переключить на Эко)"}\n'
else
    printf '{"text": "󰾆 ECO", "class": "eco", "tooltip": "Режим: Эко (ЛКМ — переключить на Перфоманс)"}\n'
fi
