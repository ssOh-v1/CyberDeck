#!/usr/bin/python3
import os, json, subprocess

os.environ.pop("LD_PRELOAD", None)
HOME = os.path.expanduser("~")
MODELS_F = os.path.join(HOME, ".config/cyberdeck/ai_models.json")
GEM_KEY_F = os.path.join(HOME, ".config/cyberdeck/gemini_api_key.txt")
ROFI_T   = os.path.join(HOME, ".config/hypr/cyber_wifi.rasi")

CATALOG = [
    {"id": "gemini-main",   "name": "✦ Gemini 2.5 (Основной ассистент)",    "provider": "gemini-bridge", "model": "gemini"},
    {"id": "gemini-coder",  "name": "✦ Gemini Coder (Python / Pygame / C#)","provider": "gemini-bridge", "model": "qwen-coder"},
    {"id": "gemini-pro",    "name": "✦ Gemini Pro (Архитектура и Логика)",  "provider": "gemini-bridge", "model": "gemini-large"},
    {"id": "claude-hybrid", "name": "Claude 3.5 Sonnet (Анализ и Код)",     "provider": "pollinations",  "model": "claude-hybridspace"},
    {"id": "qwq-32b",       "name": "Qwen QwQ 32B (Математика и Физика)",   "provider": "pollinations",  "model": "qwq"},
    {"id": "llama",         "name": "Llama 3.3 70B (Быстрый диалог)",       "provider": "pollinations",  "model": "llama"},
    {"id": "mistral",       "name": "Mistral Small 3 (Код и Текст)",        "provider": "pollinations",  "model": "mistral"},
    {"id": "codellama",     "name": "Ollama: CodeLlama (Локальная)",        "provider": "ollama",        "model": "codellama"},
]

def rofi_ask(prompt, lines):
    cmd = ["rofi", "-dmenu", "-i", "-p", prompt]
    if os.path.isfile(ROFI_T): cmd += ["-theme", ROFI_T]
    p = subprocess.run(cmd, input="\n".join(lines), text=True, capture_output=True)
    return p.stdout.strip() if p.returncode == 0 else ""

try:
    models = json.load(open(MODELS_F, encoding="utf-8"))
except Exception:
    models = []

has_key = "УСТАНОВЛЕН" if (os.path.isfile(GEM_KEY_F) and open(GEM_KEY_F).read().strip()) else "АВТО-ШЛЮЗ (БЕСПЛАТНО)"

menu = [
    f"✦  Настроить прямой ключ Google Gemini API [{has_key}]",
    "➕  Добавить нейросеть из каталога моделей",
    "🛠  Добавить свою собственную нейросеть (Custom API / Ollama / OpenRouter)",
    "🗑  Удалить нейросеть из списка виджета",
]
ch = rofi_ask("✦ AI STUDIO // НАСТРОЙКА", menu)

if "ключ Google Gemini" in ch:
    key_in = rofi_ask("Введите API-ключ Gemini (или оставьте пустым для бесплатного шлюза)", [""])
    if key_in.strip():
        open(GEM_KEY_F, "w", encoding="utf-8").write(key_in.strip())
        subprocess.Popen(["notify-send", "-a", "cyber-kb", "✦ GEMINI подключён", "Активирован прямой ключ Google Gemini API"])
    else:
        if os.path.isfile(GEM_KEY_F): os.remove(GEM_KEY_F)
        subprocess.Popen(["notify-send", "-a", "cyber-kb", "✦ GEMINI", "Используется встроенный бесплатный облачный шлюз"])

elif "из каталога" in ch:
    existing_ids = {m["id"] for m in models}
    avail = [c for c in CATALOG if c["id"] not in existing_ids]
    if not avail:
        subprocess.Popen(["notify-send", "-a", "cyber-kb", "▣ AI STUDIO", "Все модели из каталога уже в списке"])
    else:
        c_lines = [f"➕ {c['name']}  [{c['model']}]" for c in avail]
        sel = rofi_ask("Выберите модель", c_lines)
        for c in avail:
            if c["name"] in sel:
                models.insert(0, c)
                json.dump(models, open(MODELS_F, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
                break

elif "свою собственную" in ch:
    name = rofi_ask("1/4 Название нейросети", ["Моя Нейросеть"])
    if name:
        prov = rofi_ask("2/4 Тип подключения", [
            "gemini-bridge (Облачный шлюз с контекстом Gemini)",
            "pollinations (Стандартный облачный шлюз)",
            "ollama (Локальная модель из Ollama)",
            "custom (Свой URL OpenAI-совместимого API / OpenRouter)"
        ])
        prov_key = "ollama" if "ollama" in prov else ("custom" if "custom" in prov else ("gemini-bridge" if "gemini" in prov else "pollinations"))
        mod_id = rofi_ask("3/4 ID модели (например: gemini, openai, llama3)", ["gemini"])
        api_url, api_key = "", ""
        if prov_key == "custom":
            api_url = rofi_ask("4/4 URL API", ["https://openrouter.ai/api/v1/chat/completions"])
            api_key = rofi_ask("API Ключ", [""])
        if mod_id:
            models.insert(0, {"id": f"custom-{len(models)+1}", "name": name, "provider": prov_key, "model": mod_id, "url": api_url, "key": api_key})
            json.dump(models, open(MODELS_F, "w", encoding="utf-8"), ensure_ascii=False, indent=2)

elif "Удалить" in ch and len(models) > 1:
    d_lines = [f"🗑 {m['name']}" for m in models]
    sel = rofi_ask("Удалить модель", d_lines)
    models = [m for m in models if m["name"] not in sel]
    json.dump(models, open(MODELS_F, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
