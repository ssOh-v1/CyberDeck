#!/usr/bin/python3
import os, sys, math, random, cairo

HOME = os.path.expanduser("~")
WALL_DIR = os.path.join(HOME, ".config/cyberdeck/wallpapers")
CACHE_DIR = os.path.join(HOME, ".cache/cyberdeck")
os.makedirs(WALL_DIR, exist_ok=True)
os.makedirs(CACHE_DIR, exist_ok=True)

def build_gamedev_grey_wallpaper():
    W, H = 1920, 1080
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, W, H)
    cr = cairo.Context(surf)

    # Матовая графитово-серая подложка (#121316 -> #16181c)
    lg = cairo.LinearGradient(0, 0, W, H)
    lg.add_color_stop_rgb(0.0, 0.067, 0.071, 0.082)
    lg.add_color_stop_rgb(0.5, 0.082, 0.086, 0.098)
    lg.add_color_stop_rgb(1.0, 0.063, 0.067, 0.078)
    cr.set_source(lg); cr.paint()

    # Мягкий нейтрально-серый градиент в центре
    rg = cairo.RadialGradient(W * 0.5, H * 0.52, 20, W * 0.5, H * 0.52, 700)
    rg.add_color_stop_rgba(0.0, 0.45, 0.48, 0.52, 0.08)
    rg.add_color_stop_rgba(1.0, 0, 0, 0, 0)
    cr.set_source(rg); cr.paint()

    # Инженерная сетка (спокойный серый цвет)
    cr.set_line_width(0.8); cr.set_source_rgba(0.50, 0.53, 0.58, 0.03)
    for x in range(16, W, 16): cr.move_to(x, 0); cr.line_to(x, H)
    for y in range(16, H, 16): cr.move_to(0, y); cr.line_to(W, y)
    cr.stroke()

    cr.set_line_width(1.0); cr.set_source_rgba(0.50, 0.53, 0.58, 0.06)
    for x in range(64, W, 64): cr.move_to(x, 0); cr.line_to(x, H)
    for y in range(64, H, 64): cr.move_to(0, y); cr.line_to(W, y)
    cr.stroke()

    cr.set_line_width(1.3); cr.set_source_rgba(0.55, 0.58, 0.63, 0.12)
    for x in range(256, W, 256): cr.move_to(x, 0); cr.line_to(x, H)
    for y in range(256, H, 256): cr.move_to(0, y); cr.line_to(W, y)
    cr.stroke()

    cr.select_font_face("monospace", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(9.5)
    for x in range(256, W, 256):
        for y in range(256, H, 256):
            cr.set_source_rgba(0.60, 0.63, 0.68, 0.25)
            cr.move_to(x - 4, y); cr.line_to(x + 4, y)
            cr.move_to(x, y - 4); cr.line_to(x, y + 4); cr.stroke()
            cr.set_source_rgba(0.50, 0.53, 0.58, 0.28)
            cr.move_to(x + 6, y - 5)
            cr.show_text(f"SECTOR [{(x-960)//256:+d},{(y-512)//256:+d}]")

    # Линейки координат
    cr.set_source_rgba(0.08, 0.09, 0.10, 0.85)
    cr.rectangle(0, 62, 28, H - 124); cr.rectangle(28, 62, W - 56, 22); cr.fill()
    cr.set_line_width(1.0); cr.set_source_rgba(0.50, 0.53, 0.58, 0.32)
    for x in range(64, W - 64, 16):
        th = 9 if x % 64 == 0 else 4
        cr.move_to(x, 84 - th); cr.line_to(x, 84)
        if x % 128 == 0:
            cr.move_to(x + 3, 74); cr.show_text(f"{x - 960:+d}")
    for y in range(96, H - 80, 16):
        tw = 9 if y % 64 == 0 else 4
        cr.move_to(28 - tw, y); cr.line_to(28, y)
    cr.stroke()

    # Главные оси координат (приглушённый серый)
    cx, cy = W * 0.5, H * 0.54
    cr.set_line_width(1.5)
    cr.set_source_rgba(0.55, 0.58, 0.63, 0.26)
    cr.move_to(28, cy); cr.line_to(W - 28, cy)
    cr.move_to(cx, 84); cr.line_to(cx, H - 60); cr.stroke()

    # Левый верхний угол: Граф нод в строгих серых оттенках
    nodes = [
        (64,  112, 145, 68, "Input_Controller", ["axis_x", "jump_pressed"]),
        (255, 102, 155, 78, "Player_FSM_State", ["STATE: IDLE", "vel_xy"]),
        (255, 202, 155, 68, "Physics2D_Solver", ["gravity: 980", "ray_hit"]),
        (456, 142, 150, 74, "Vulkan_SpritePass", ["contrast: 1.0", "out_rgba"]),
    ]
    wires = [
        (64+145, 112+36, 255, 102+34),
        (64+145, 112+52, 255, 202+34),
        (255+155, 102+44, 456, 142+32),
        (255+155, 202+36, 456, 142+52),
    ]
    cr.set_line_width(1.8)
    for x1, y1, x2, y2 in wires:
        cr.set_source_rgba(0.55, 0.58, 0.64, 0.38)
        cr.move_to(x1, y1); cr.curve_to(x1 + 45, y1, x2 - 45, y2, x2, y2); cr.stroke()

    for nx, ny, nw, nh, ntitle, nports in nodes:
        cr.set_source_rgba(0.10, 0.11, 0.13, 0.90)
        cr.rectangle(nx, ny, nw, nh); cr.fill_preserve()
        cr.set_line_width(1.2); cr.set_source_rgba(0.32, 0.35, 0.40, 0.65); cr.stroke()
        cr.set_source_rgba(0.22, 0.24, 0.28, 0.90)
        cr.rectangle(nx, ny, nw, 18); cr.fill()
        cr.set_font_size(9.5); cr.set_source_rgba(0.82, 0.84, 0.88, 0.85)
        cr.move_to(nx + 6, ny + 13); cr.show_text(f"◆ {ntitle}")
        for idx, pt_txt in enumerate(nports):
            py_p = ny + 35 + idx * 18
            cr.set_source_rgba(0.62, 0.65, 0.70, 0.80)
            cr.move_to(nx + 10, py_p); cr.show_text(pt_txt)
            cr.arc(nx, py_p - 3, 3.0, 0, 2*math.pi); cr.set_source_rgba(0.55, 0.58, 0.64, 0.8); cr.fill()
            cr.arc(nx + nw, py_p - 3, 3.0, 0, 2*math.pi); cr.set_source_rgba(0.55, 0.58, 0.64, 0.8); cr.fill()

    # Правый верхний угол: Профайлер в сером стиле
    px0, py0, pw0, ph0 = W - 470, 104, 420, 145
    cr.set_source_rgba(0.10, 0.11, 0.13, 0.88)
    cr.rectangle(px0, py0, pw0, ph0); cr.fill_preserve()
    cr.set_line_width(1.2); cr.set_source_rgba(0.32, 0.35, 0.40, 0.65); cr.stroke()
    cr.set_font_size(10.0); cr.set_source_rgba(0.75, 0.78, 0.82, 0.85)
    cr.move_to(px0 + 12, py0 + 18); cr.show_text("VULKAN PROFILER // FRAME_TIME: 4.1 ms")
    cr.set_font_size(9.5); cr.set_source_rgba(0.55, 0.58, 0.64, 0.75)
    cr.move_to(px0 + 12, py0 + 36); cr.show_text("DrawCalls: 128   •   Vertices: 18,420   •   Physics2D: 0.38 ms")
    cr.set_line_width(1.8); cr.set_source_rgba(0.50, 0.53, 0.58, 0.55)
    random.seed(7)
    for gx in range(px0 + 14, px0 + pw0 - 14, 6):
        gh = random.randint(12, 48)
        cr.move_to(gx, py0 + ph0 - 14); cr.line_to(gx, py0 + ph0 - 14 - gh)
    cr.stroke()

    # Центральная сцена Camera2D и геометрия уровня (монохром)
    cam_w, cam_h = 1040, 520
    cam_x, cam_y = cx - cam_w * 0.5, cy - cam_h * 0.5 + 20
    cr.set_line_width(1.5); cr.set_source_rgba(0.48, 0.51, 0.56, 0.42)
    cr.rectangle(cam_x, cam_y, cam_w, cam_h); cr.stroke()
    cr.set_font_size(10.0); cr.set_source_rgba(0.62, 0.65, 0.70, 0.68)
    cr.move_to(cam_x + 10, cam_y - 8)
    cr.show_text("Camera2D [Current]  •  Zoom: 1.00x  •  Viewport: 1920x1080")

    level_rects = [
        (cx - 420, cy + 130, 840, 64, "TileMap_Floor [StaticBody2D]"),
        (cx - 380, cy - 10,  260, 32, "Platform_A [OneWayCollision]"),
        (cx - 40,  cy - 74,  220, 32, "Platform_B [MovingPlatform2D]"),
        (cx + 220, cy + 10,  240, 32, "Platform_C [StaticBody2D]"),
    ]
    for rx, ry, rw, rh, rlabel in level_rects:
        cr.set_source_rgba(0.16, 0.18, 0.21, 0.48)
        cr.rectangle(rx, ry, rw, rh); cr.fill()
        cr.set_line_width(1.0); cr.set_source_rgba(0.35, 0.38, 0.42, 0.30)
        for tx in range(int(rx), int(rx + rw), 32):
            cr.move_to(tx, ry); cr.line_to(tx, ry + rh)
        cr.stroke()
        cr.set_line_width(1.5); cr.set_source_rgba(0.52, 0.55, 0.60, 0.58)
        cr.rectangle(rx, ry, rw, rh); cr.stroke()
        cr.set_font_size(9.5); cr.move_to(rx + 6, ry - 5); cr.show_text(rlabel)

    # Таймлайн анимации внизу слева
    ax0, ay0, aw0, ah0 = 64, H - 185, 760, 96
    cr.set_source_rgba(0.10, 0.11, 0.13, 0.88)
    cr.rectangle(ax0, ay0, aw0, ah0); cr.fill_preserve()
    cr.set_line_width(1.2); cr.set_source_rgba(0.32, 0.35, 0.40, 0.60); cr.stroke()
    cr.set_font_size(10.0); cr.set_source_rgba(0.68, 0.71, 0.76, 0.80)
    cr.move_to(ax0 + 12, ay0 + 18)
    cr.show_text("AnimationPlayer // Track: idle_cycle.anim   •   FPS: 60")
    for f_i in range(8):
        fx = ax0 + 14 + f_i * 92
        fy = ay0 + 28
        is_act = (f_i == 3)
        cr.set_source_rgba(*( (0.22, 0.24, 0.28, 0.85) if is_act else (0.13, 0.14, 0.17, 0.85) ))
        cr.rectangle(fx, fy, 84, 54); cr.fill_preserve()
        cr.set_line_width(1.5 if is_act else 1.0)
        cr.set_source_rgba(0.58, 0.61, 0.66, 0.75 if is_act else 0.35); cr.stroke()
        cr.set_font_size(9.0); cr.set_source_rgba(0.75, 0.78, 0.82, 0.80)
        cr.move_to(fx + 6, fy + 15); cr.show_text(f"FRM_0{f_i+1}")
        cr.move_to(fx + 6, fy + 44); cr.show_text(f"{f_i * 33}ms")

    out_w = os.path.join(WALL_DIR, "gamedev-studio.png")
    surf.write_to_png(out_w)
    for nm in ("work_hud_bg.png", "gaming_hud_bg.png", "cyberdeck_hud_bg.png", "lock_hud_bg.png"):
        surf.write_to_png(os.path.join(CACHE_DIR, nm))
    surf.write_to_png(os.path.join(HOME, ".config/hypr/assets/terminal_hud_bg.png"))

    # Фон для SDDM с мягким центральным затемнением
    vg = cairo.RadialGradient(W * 0.5, H * 0.5, 160, W * 0.5, H * 0.5, 760)
    vg.add_color_stop_rgba(0.0, 0.06, 0.065, 0.075, 0.84)
    vg.add_color_stop_rgba(1.0, 0.04, 0.045, 0.055, 0.30)
    cr.set_source(vg); cr.paint()
    surf.write_to_png(os.path.join(CACHE_DIR, "sddm_bg.png"))

if __name__ == "__main__":
    build_gamedev_grey_wallpaper()
