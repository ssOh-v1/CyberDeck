#!/usr/bin/python3
import os, json, importlib.util
HOME = os.path.expanduser("~")
try:
    _spec = importlib.util.spec_from_file_location("cyber_bg_helper", os.path.join(HOME, ".local/bin/cyber-bg-helper.py"))
    cyber_bg = importlib.util.module_from_spec(_spec)
    _spec.loader.exec_module(cyber_bg)
    items = cyber_bg.get_bg_and_open_items()
    cnt = sum(i.get("count", 1) for i in items)
    print(json.dumps({"text": f"󰘔 {cnt}", "tooltip": f"Фоновые и открытые окна: {cnt}\nЛКМ — управление окнами"}))
except Exception:
    print(json.dumps({"text": "󰘔 0", "tooltip": "Фоновые окна"}))
