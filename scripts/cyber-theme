def hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i+2], 16) / 255.0 for i in (0, 2, 4))

def hex_rgb_int(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def is_gaming_session():
    if "game" in os.environ.get("HYPRLAND_CONFIG", "").lower():
        return True
    return subprocess.call(["pgrep", "-f", "game-hub-desktop.py"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0

def get_session_theme_id(sess_type=None):
    if sess_type is None:
        sess_type = "game" if is_gaming_session() else "work"
    sfile = GAME_STATE if sess_type == "game" else WORK_STATE
    default_id = "game-scanout" if sess_type == "game" else "cyber-tactical"
    try:
        if os.path.isfile(sfile):
            tid = json.load(open(sfile, encoding="utf-8")).get("id", "")
            if tid in THEMES:
                return tid
    except Exception:
        pass
    return default_id

def build_full_theme_css(t):
    p, a, s, bg, bg_alt, fg = t["primary"], t["accent"], t["soft"], t["bg"], t["bg_alt"], t["fg"]
    cbg, dbg = t["card_bg"], t["deck_bg"]
    r = int(t["radius"])
    r_sm = max(3, r - 3)
    arch = t["arch"]

    if arch == "ronin":
        deck_border = f"border: 1px solid {p}; border-bottom: 2px solid {a};"
        card_border = f"border: 1px solid {p}; border-left: 4px solid {a};"
    elif arch == "matrix":
        deck_border = f"border: 1px solid {a};"
        card_border = f"border: 1px solid {p}; border-top: 2px solid {a};"
    elif arch == "synth":
        deck_border = f"border: 1px solid {p}; border-top: 2px solid {a};"
        card_border = f"border: 1px solid {p}; border-bottom: 2px solid {a};"
    elif arch == "cryo":
        deck_border = f"border: 1px solid {a};"
        card_border = f"border: 1px solid {p};"
    else:
        deck_border = f"border: 1px solid {p};"
        card_border = f"border: 1px solid {p};"

    return f"""
