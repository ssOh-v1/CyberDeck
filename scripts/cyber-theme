# ==============================================================================
# ГЕНЕРАТОРЫ ОБОЕВ ДЛЯ ВСЕХ 5 МИРОВ (Включая Лесной Ручей и 3D-бугорки Импасто)
# ==============================================================================
def draw_impasto_stroke(cr, x, y, w, h, angle, r, g, b):
    # Рисует объёмный густой мазок масляной краски с 3D-бугорком (верхний световой блик + нижняя густая тень + бороздки кисти)
    cr.save()
    cr.translate(x, y)
    cr.rotate(angle)
    # 1. Тень под бугорком краски
    cr.set_source_rgba(max(0, r*0.32), max(0, g*0.30), max(0, b*0.28), 0.78)
    cr.rectangle(-w/2 + 2.2, -h/2 + 2.8, w, h)
    cr.fill()
    # 2. Световой гребень бугорка (верхняя грань мазка)
    cr.set_source_rgba(min(1, r*1.28 + 0.08), min(1, g*1.24 + 0.06), min(1, b*1.18 + 0.05), 0.92)
    cr.rectangle(-w/2 - 1.4, -h/2 - 1.8, w, h * 0.45)
    cr.fill()
    # 3. Основное густое тело краски
    cr.set_source_rgba(r, g, b, 0.96)
    cr.rectangle(-w/2, -h/2, w, h)
    cr.fill()
    # 4. Фактурные бороздки от щетины кисти / мастихина
    cr.set_line_width(1.1)
    cr.set_source_rgba(min(1, r*1.35 + 0.10), min(1, g*1.30 + 0.08), min(1, b*1.22 + 0.06), 0.45)
    for by in (-h*0.28, 0.0, h*0.25):
        cr.move_to(-w*0.44, by); cr.line_to(w*0.44, by)
    cr.stroke()
    cr.restore()

def render_world_wallpaper(t):
    W, H = 1920, 1080
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, W, H)
    cr = cairo.Context(surf)
    lay = t["layout"]
    PRIM, ACC, BG = hex_rgb(t["primary"]), hex_rgb(t["accent"]), hex_rgb(t["bg"])

    if lay == "forest":
        # === МИР 3: ЛЕСНОЙ РУЧЕЙ (Многослойные сосны, солнечные лучи в тумане, горный ручей с камнями и бликами) ===
        sky = cairo.LinearGradient(0, 0, 0, H * 0.65)
        sky.add_color_stop_rgb(0.0, 0.04, 0.11, 0.09)
        sky.add_color_stop_rgb(0.5, 0.08, 0.22, 0.17)
        sky.add_color_stop_rgb(1.0, 0.16, 0.38, 0.28)
        cr.set_source(sky); cr.paint()

        # Мягкое утреннее солнце и сквозные лучи сквозь кроны
        sun = cairo.RadialGradient(W * 0.52, H * 0.18, 10, W * 0.52, H * 0.18, 520)
        sun.add_color_stop_rgba(0.0, 0.78, 0.96, 0.84, 0.35)
        sun.add_color_stop_rgba(0.5, 0.45, 0.80, 0.62, 0.12)
        sun.add_color_stop_rgba(1.0, 0, 0, 0, 0)
        cr.set_source(sun); cr.paint()

        # Дальние лесные склоны и силуэты елей в дымке
        random.seed(108)
        for layer_i, (base_y, col_r, col_g, col_b, tree_h) in enumerate([
            (H * 0.50, 0.09, 0.24, 0.18, 130),
            (H * 0.58, 0.06, 0.18, 0.13, 175),
            (H * 0.67, 0.04, 0.12, 0.09, 220),
        ]):
            cr.set_source_rgb(col_r, col_g, col_b)
            cr.move_to(0, H); cr.line_to(0, base_y)
            for x in range(0, W + 60, 45):
                ty = base_y - random.randint(20, tree_h)
                cr.line_to(x - 18, base_y)
                cr.line_to(x, ty)
                cr.line_to(x + 18, base_y)
            cr.line_to(W, H); cr.close_path(); cr.fill()

        # Берега мшистого ущелья
        cr.set_source_rgb(0.03, 0.09, 0.06)
        cr.rectangle(0, H * 0.64, W, H * 0.36); cr.fill()

        # Извилистый горный ручей с зеркальной бирюзовой водой
        stream_pts_l = [(W*0.46, H*0.62), (W*0.38, H*0.73), (W*0.26, H*0.86), (W*0.14, H)]
        stream_pts_r = [(W*0.56, H*0.62), (W*0.65, H*0.74), (W*0.78, H*0.87), (W*0.88, H)]
        cr.move_to(*stream_pts_l[0])
        for p in stream_pts_l[1:]: cr.line_to(*p)
        for p in reversed(stream_pts_r): cr.line_to(*p)
        cr.close_path()
        w_lg = cairo.LinearGradient(0, H * 0.62, 0, H)
        w_lg.add_color_stop_rgb(0.0, 0.22, 0.58, 0.48)
        w_lg.add_color_stop_rgb(0.5, 0.14, 0.42, 0.36)
        w_lg.add_color_stop_rgb(1.0, 0.08, 0.26, 0.24)
        cr.set_source(w_lg); cr.fill()

        # Водная рябь, пороги и речные валуны
        cr.set_line_width(2.2)
        for i in range(28):
            ry = H * 0.64 + (i / 28.0) * (H * 0.34)
            spread = 50 + (i / 28.0) * 480
            rx = W * 0.51 + math.sin(i * 0.55) * 45 + random.uniform(-spread*0.4, spread*0.4)
            rw = random.uniform(28, 85)
            cr.set_source_rgba(0.72, 0.96, 0.85, 0.38)
            cr.move_to(rx - rw/2, ry); cr.line_to(rx + rw/2, ry); cr.stroke()

        # Речные камни и светлячки над водой
        for bx, by, br in [(W*0.39, H*0.78, 26), (W*0.61, H*0.82, 34), (W*0.32, H*0.91, 42), (W*0.68, H*0.93, 38)]:
            cr.arc(bx, by, br, math.pi, 2*math.pi)
            cr.set_source_rgb(0.12, 0.19, 0.16); cr.fill_preserve()
            cr.set_line_width(1.8); cr.set_source_rgba(0.58, 0.88, 0.74, 0.5); cr.stroke()

        for _ in range(35):
            fx, fy = random.uniform(120, W - 120), random.uniform(140, H - 100)
            fg_g = cairo.RadialGradient(fx, fy, 1, fx, fy, 14)
            fg_g.add_color_stop_rgba(0, 0.80, 1.0, 0.75, 0.65)
            fg_g.add_color_stop_rgba(1, 0.45, 0.85, 0.60, 0.0)
            cr.set_source(fg_g); cr.arc(fx, fy, 14, 0, 2*math.pi); cr.fill()

    elif lay == "impasto":
        # === МИР 4: ИМПАСТО ПЕЙЗАЖ (Густые рельефные мазки масла с физическими бугорками и светотенью) ===
        random.seed(77)
        cr.set_source_rgb(0.11, 0.09, 0.08); cr.paint()

        # 1. Небо на закате — вихревые рельефные мазки вокруг золотого солнца (в духе Ван Гога / импасто)
        sun_x, sun_y = W * 0.64, H * 0.30
        for y in range(0, int(H * 0.58), 16):
            for x in range(0, W, 28):
                dx, dy = x - sun_x, y - sun_y
                dist = math.hypot(dx, dy)
                ang = math.atan2(dy, dx) + math.pi / 2.0 + math.sin(x * 0.006) * 0.25
                if dist < 170:
                    col = (0.97, 0.84, 0.46)
                elif dist < 340:
                    col = (0.91, 0.56, 0.36)
                elif y < H * 0.26:
                    col = (0.16, 0.22, 0.38)
                else:
                    col = (0.26, 0.31, 0.46)
                jit = random.uniform(-0.04, 0.04)
                draw_impasto_stroke(
                    cr, x + random.uniform(-6, 6), y + random.uniform(-5, 5),
                    random.uniform(34, 54), random.uniform(13, 20), ang,
                    min(1, max(0, col[0]+jit)), min(1, max(0, col[1]+jit)), min(1, max(0, col[2]+jit))
                )

        # 2. Горная гряда — косые рельефные мазки мастихина (терракота, индиго и охра)
        for x in range(0, W, 24):
            ridge_top = H * 0.47 + math.sin(x * 0.0045) * 65 + math.cos(x * 0.011) * 30
            for y in range(int(ridge_top), int(H * 0.72), 15):
                t_rel = (y - ridge_top) / max(1.0, (H * 0.72 - ridge_top))
                r = 0.22 + 0.42 * (1.0 - t_rel) + random.uniform(-0.04, 0.04)
                g = 0.18 + 0.25 * (1.0 - t_rel) + random.uniform(-0.03, 0.03)
                b = 0.28 + 0.18 * t_rel + random.uniform(-0.03, 0.03)
                draw_impasto_stroke(cr, x, y, random.uniform(32, 48), random.uniform(14, 21), -0.38 if (x % 48 == 0) else 0.32, r, g, b)

        # 3. Передний план — золотисто-охристые поля и отражения воды густыми горизонтальными бугорками
        for y in range(int(H * 0.68), H + 10, 14):
            for x in range(0, W, 26):
                is_river = abs(x - (W * 0.54 + math.sin(y * 0.02) * 140)) < (80 + (y - H*0.68)*0.6)
                if is_river:
                    col = (0.24, 0.46, 0.56) if random.random() > 0.35 else (0.94, 0.78, 0.48)
                else:
                    col = (0.78, 0.44, 0.28) if random.random() > 0.45 else (0.88, 0.68, 0.36)
                draw_impasto_stroke(
                    cr, x + random.uniform(-5, 5), y,
                    random.uniform(36, 56), random.uniform(12, 18),
                    random.uniform(-0.12, 0.12),
                    col[0] + random.uniform(-0.04, 0.04), col[1] + random.uniform(-0.04, 0.04), col[2] + random.uniform(-0.04, 0.04)
                )

        # 4. Фактурные кипарисы справа (вертикальные густые мазки тёмного изумруда и бронзы)
        for tree_x, tree_w, tree_top in [(W * 0.86, 74, H * 0.16), (W * 0.92, 52, H * 0.28)]:
            for y in range(int(tree_top), int(H * 0.88), 14):
                w_cur = tree_w * math.sin(((y - tree_top) / (H * 0.88 - tree_top)) * math.pi * 0.85)
                for x in range(int(tree_x - w_cur/2), int(tree_x + w_cur/2), 14):
                    draw_impasto_stroke(cr, x, y, 16, 26, -1.45 + random.uniform(-0.2, 0.2), 0.10 + random.uniform(0, 0.08), 0.22 + random.uniform(0, 0.10), 0.15)

    elif lay == "dungeon":
        # === МИР 2: THE DUNGEON OF GOD (Каменные своды подземелья, алтарь, факелы и руны для SDDM/статичного кэша) ===
        cr.set_source_rgb(0.04, 0.025, 0.022); cr.paint()
        # Каменная кладка подземелья
        for row, y in enumerate(range(0, H, 64)):
            ox = 48 if (row % 2) else 0
            for x in range(-48, W, 96):
                cr.set_source_rgba(0.09, 0.06, 0.05, 0.85)
                cr.rectangle(x + ox + 2, y + 2, 92, 60); cr.fill_preserve()
                cr.set_line_width(1.2); cr.set_source_rgba(0.22, 0.14, 0.11, 0.45); cr.stroke()

        # Свет факелов и рунический круг в центре
        for tx, ty in [(W*0.22, H*0.42), (W*0.78, H*0.42), (W*0.50, H*0.55)]:
            rg = cairo.RadialGradient(tx, ty, 8, tx, ty, 440)
            rg.add_color_stop_rgba(0.0, 0.96, 0.58, 0.18, 0.26)
            rg.add_color_stop_rgba(0.5, 0.85, 0.22, 0.14, 0.10)
            rg.add_color_stop_rgba(1.0, 0, 0, 0, 0)
            cr.set_source(rg); cr.paint()

        cx, cy = W * 0.5, H * 0.54
        cr.set_line_width(2.2); cr.set_source_rgba(0.96, 0.72, 0.20, 0.32)
        cr.arc(cx, cy, 240, 0, 2*math.pi); cr.stroke()
        cr.arc(cx, cy, 224, 0, 2*math.pi); cr.stroke()

    elif lay == "gamedev":
        # === МИР 5: GAMEDEV ENGINE STUDIO (Чертёжный Viewport 2D/3D с осями координат X/Y и пиксельной сеткой) ===
        cr.set_source_rgb(0.05, 0.065, 0.085); cr.paint()
        cr.set_line_width(1.0); cr.set_source_rgba(0.28, 0.55, 0.75, 0.06)
        for x in range(32, W, 32): cr.move_to(x, 0); cr.line_to(x, H)
        for y in range(32, H, 32): cr.move_to(0, y); cr.line_to(W, y)
        cr.stroke()
        cr.set_source_rgba(0.28, 0.55, 0.75, 0.14)
        for x in range(128, W, 128): cr.move_to(x, 0); cr.line_to(x, H)
        for y in range(128, H, 128): cr.move_to(0, y); cr.line_to(W, y)
        cr.stroke()
        # Главные оси координат сцены (X — красная, Y — зелёная, как в Godot / Unity)
        cx, cy = W * 0.5, H * 0.52
        cr.set_line_width(2.0)
        cr.set_source_rgba(0.92, 0.32, 0.36, 0.45); cr.move_to(0, cy); cr.line_to(W, cy); cr.stroke()
        cr.set_source_rgba(0.38, 0.85, 0.58, 0.45); cr.move_to(cx, 0); cr.line_to(cx, H); cr.stroke()

    else:
        # === МИР 1: CYBERDECK CLASSIC ===
        cr.set_source_rgb(*BG); cr.paint()
        for cx, cy, rad, col, al in [(W*0.15, H*0.14, 620, PRIM, 0.13), (W*0.85, H*0.86, 620, ACC, 0.11)]:
            rg = cairo.RadialGradient(cx, cy, 10, cx, cy, rad)
            rg.add_color_stop_rgba(0, *col, al); rg.add_color_stop_rgba(1, *col, 0)
            cr.set_source(rg); cr.paint()
        cr.set_line_width(1.0); cr.set_source_rgba(*PRIM, 0.068)
        for x in range(96, W, 96): cr.move_to(x, 0); cr.line_to(x, H)
        for y in range(96, H, 96): cr.move_to(0, y); cr.line_to(W, y)
        cr.stroke()
        m, ln = 14, 52
        cr.set_line_width(2.4); cr.set_source_rgba(*ACC, 0.78)
        for x1, y1, x2, y2, x3, y3 in [(m,m+ln,m,m,m+ln,m),(W-m-ln,m,W-m,m,W-m,m+ln),(m,H-m-ln,m,H-m,m+ln,H-m),(W-m-ln,H-m,W-m,H-m,W-m,H-m-ln)]:
            cr.move_to(x1, y1); cr.line_to(x2, y2); cr.line_to(x3, y3)
        cr.stroke()

    for nm in ("work_hud_bg.png", "gaming_hud_bg.png", "cyberdeck_hud_bg.png", "sddm_bg.png", "lock_hud_bg.png"):
        surf.write_to_png(os.path.join(CACHE_DIR, nm))
    surf.write_to_png(os.path.join(HOME, ".config/hypr/assets/terminal_hud_bg.png"))

def rebuild_world_cursor(theme_id, t):
    cur_name = f"CyberDeck-Cursor-{theme_id}"
    icons_root = os.path.join(HOME, ".local/share/icons")
    for old_d in glob.glob(os.path.join(icons_root, "CyberDeck-Cursor*")):
        shutil.rmtree(old_d, ignore_errors=True)

    theme_dir = os.path.join(icons_root, cur_name)
    cursors_dir = os.path.join(theme_dir, "cursors")
    os.makedirs(cursors_dir, exist_ok=True)
    open(os.path.join(theme_dir, "index.theme"), "w", encoding="utf-8").write(
        f"[Icon Theme]\nName={cur_name}\nComment=CyberDeck {t['short']} Cursor\nInherits=Adwaita\n"
    )

    PRIM, ACC, DARK = hex_rgb(t["primary"]), hex_rgb(t["accent"]), hex_rgb(t["bg"])
    shape = t.get("cursor_shape", "cyber")

    def new_surf(sz):
        s = cairo.ImageSurface(cairo.FORMAT_ARGB32, sz, sz)
        cr = cairo.Context(s); cr.scale(sz / 32.0, sz / 32.0)
        cr.set_line_cap(cairo.LINE_CAP_ROUND); cr.set_line_join(cairo.LINE_JOIN_ROUND)
        return s, cr

    def draw_arrow(cr):
        if shape == "dagger":
            # 2. THE DUNGEON OF GOD: Рунический клинок искателя подземелий (тёмная сталь + золотая руна + багровая кромка)
            pts = [(2.5, 2.0), (4.0, 24.5), (9.5, 19.2), (14.2, 27.2), (17.5, 25.2), (12.8, 17.5), (21.0, 15.0)]
            cr.save(); cr.translate(1.2, 1.5); cr.move_to(*pts[0])
            for pt in pts[1:]: cr.line_to(*pt)
            cr.close_path(); cr.set_source_rgba(0, 0, 0, 0.60); cr.fill(); cr.restore()

            cr.move_to(*pts[0])
            for pt in pts[1:]: cr.line_to(*pt)
            cr.close_path()
            cr.set_source_rgba(0.12, 0.07, 0.06, 0.97); cr.fill_preserve()
            cr.set_line_width(2.0); cr.set_source_rgb(*ACC); cr.stroke()
            # Внутренняя руна огня
            cr.set_line_width(1.6); cr.set_source_rgb(*PRIM)
            cr.move_to(5.0, 6.0); cr.line_to(11.0, 16.0); cr.stroke()
            cr.arc(5.2, 6.2, 1.8, 0, 2*math.pi); cr.set_source_rgb(*ACC); cr.fill()

        elif shape == "leaf":
            # 3. ЛЕСНОЙ РУЧЕЙ: Органический изумрудный лист с прожилкой росы
            pts = [(3.0, 2.5), (3.5, 24.0), (9.0, 19.2), (13.0, 26.8), (16.2, 25.0), (12.2, 17.5), (19.8, 16.5)]
            cr.move_to(*pts[0])
            for pt in pts[1:]: cr.line_to(*pt)
            cr.close_path()
            cr.set_source_rgba(0.05, 0.14, 0.10, 0.96); cr.fill_preserve()
            cr.set_line_width(2.0); cr.set_source_rgb(*ACC); cr.stroke()
            cr.arc(5.5, 6.5, 1.7, 0, 2*math.pi); cr.set_source_rgb(0.85, 1.0, 0.90); cr.fill()

        elif shape == "brush":
            # 4. ИМПАСТО ПЕЙЗАЖ: Мастихин художника с золотисто-охристым мазком краски на кончике
            pts = [(3.0, 2.0), (3.5, 24.5), (9.0, 19.0), (13.5, 27.0), (16.8, 25.2), (12.2, 17.2), (20.2, 16.0)]
            cr.move_to(*pts[0])
            for pt in pts[1:]: cr.line_to(*pt)
            cr.close_path()
            cr.set_source_rgba(0.16, 0.11, 0.09, 0.96); cr.fill_preserve()
            cr.set_line_width(2.0); cr.set_source_rgb(*PRIM); cr.stroke()
            cr.arc(5.2, 6.0, 2.1, 0, 2*math.pi); cr.set_source_rgb(*ACC); cr.fill()

        elif shape == "gizmo":
            # 5. GAMEDEV ENGINE STUDIO: Инженерный курсор-гизмо с осями X/Y у вершины
            pts = [(3, 2), (3, 24), (8.8, 19.2), (12.6, 27.5), (16.0, 25.8), (12.2, 17.6), (19.8, 17.6)]
            cr.move_to(*pts[0])
            for pt in pts[1:]: cr.line_to(*pt)
            cr.close_path()
            cr.set_source_rgba(0.08, 0.11, 0.15, 0.97); cr.fill_preserve()
            cr.set_line_width(1.9); cr.set_source_rgb(*PRIM); cr.stroke()
            cr.set_line_width(1.8); cr.set_source_rgb(*ACC)
            cr.move_to(5.0, 5.5); cr.line_to(5.0, 14.5); cr.move_to(5.0, 5.5); cr.line_to(13.0, 12.0); cr.stroke()

        else:
            # 1. CYBERDECK CLASSIC
            pts = [(3,2),(3,24),(8.8,19.2),(12.6,27.5),(16.0,25.8),(12.2,17.6),(19.8,17.6)]
            cr.move_to(*pts[0])
            for pt in pts[1:]: cr.line_to(*pt)
            cr.close_path()
            cr.set_source_rgba(*DARK, 0.96); cr.fill_preserve()
            cr.set_line_width(1.9); cr.set_source_rgb(*ACC); cr.stroke()
            cr.arc(5.2, 5.8, 1.6, 0, 2*math.pi); cr.set_source_rgb(*PRIM); cr.fill()

    def draw_pointer(cr):
        pts = [(6, 5), (6, 23), (11.2, 18.8), (15.5, 26), (18.5, 24.4), (14.2, 17.2), (21, 17.2)]
        cr.move_to(*pts[0])
        for pt in pts[1:]: cr.line_to(*pt)
        cr.close_path()
        cr.set_source_rgba(*DARK, 0.96); cr.fill_preserve()
        cr.set_source_rgb(*ACC); cr.set_line_width(1.9); cr.stroke()
        cx, cy, r = 6.0, 5.0, 3.2
        cr.move_to(cx, cy - r); cr.line_to(cx + r, cy); cr.line_to(cx, cy + r); cr.line_to(cx - r, cy); cr.close_path()
        cr.set_source_rgb(*PRIM); cr.fill_preserve()
        cr.set_source_rgb(1, 1, 1); cr.set_line_width(1.2); cr.stroke()

    def draw_ibeam(cr):
        cr.set_line_width(2.2); cr.set_source_rgb(*ACC)
        cr.move_to(16,5); cr.line_to(16,27); cr.move_to(11.5,5); cr.line_to(20.5,5); cr.move_to(11.5,27); cr.line_to(20.5,27); cr.stroke()

    def draw_cross(cr):
        cr.set_line_width(2.0); cr.set_source_rgb(*ACC)
        for x1,y1,x2,y2 in [(16,3,16,11),(16,21,16,29),(3,16,11,16),(21,16,29,16)]: cr.move_to(x1,y1); cr.line_to(x2,y2)
        cr.stroke()
        cr.set_line_width(1.5); cr.set_source_rgb(*PRIM); cr.arc(16,16,6.5,0,2*math.pi); cr.stroke()

    def draw_darrow(cr, ang):
        cr.save(); cr.translate(16,16); cr.rotate(math.radians(ang))
        cr.set_line_width(2.2); cr.set_source_rgb(*ACC)
        cr.move_to(-10,0); cr.line_to(10,0); cr.move_to(-6,-4.5); cr.line_to(-11,0); cr.line_to(-6,4.5); cr.move_to(6,-4.5); cr.line_to(11,0); cr.line_to(6,4.5); cr.stroke()
        cr.restore()

    def draw_spin(cr, ph, mini=False):
        cx, cy, r = (22.5, 21.5, 6.2) if mini else (16.0, 16.0, 10.5)
        cr.arc(cx,cy,r,0,2*math.pi); cr.set_source_rgba(*DARK,0.88); cr.fill()
        a0 = ph * 2 * math.pi
        cr.set_line_width(2.5); cr.set_source_rgb(*ACC); cr.arc(cx,cy,r,a0,a0+math.pi*0.9); cr.stroke()
        cr.set_source_rgb(*PRIM); cr.arc(cx,cy,r,a0+math.pi,a0+math.pi*1.55); cr.stroke()

    tmp = tempfile.mkdtemp(prefix="cd_cur_")
    try:
        sizes = [24, 32, 48]
        def b_static(name, hx32, hy32, fn):
            lines = []
            for sz in sizes:
                s, cr = new_surf(sz); fn(cr)
                png = os.path.join(tmp, f"{name}_{sz}.png"); s.write_to_png(png)
                lines.append(f"{sz} {int(round(hx32*sz/32.0))} {int(round(hy32*sz/32.0))} {png}")
            cfg = os.path.join(tmp, f"{name}.cfg"); open(cfg,"w").write("\n".join(lines)+"\n")
            subprocess.run(["xcursorgen", cfg, os.path.join(cursors_dir, name)], check=True)
        def b_anim(name, hx32, hy32, mini=False):
            lines = []
            for sz in sizes:
                for fr in range(10):
                    s, cr = new_surf(sz)
                    if mini: draw_arrow(cr)
                    draw_spin(cr, fr/10.0, mini)
                    png = os.path.join(tmp, f"{name}_{sz}_{fr}.png"); s.write_to_png(png)
                    lines.append(f"{sz} {int(round(hx32*sz/32.0))} {int(round(hy32*sz/32.0))} {png} 60")
            cfg = os.path.join(tmp, f"{name}.cfg"); open(cfg,"w").write("\n".join(lines)+"\n")
            subprocess.run(["xcursorgen", cfg, os.path.join(cursors_dir, name)], check=True)

        b_static("left_ptr", 3, 2, draw_arrow)
        b_static("hand2", 6, 5, draw_pointer)
        b_static("xterm", 16, 16, draw_ibeam)
        b_static("crosshair", 16, 16, draw_cross)
        b_static("fleur", 16, 16, lambda cr: (draw_darrow(cr,0), draw_darrow(cr,90)))
        b_static("sb_h_double_arrow", 16, 16, lambda cr: draw_darrow(cr,0))
        b_static("sb_v_double_arrow", 16, 16, lambda cr: draw_darrow(cr,90))
        b_static("bd_double_arrow", 16, 16, lambda cr: draw_darrow(cr,45))
        b_static("fd_double_arrow", 16, 16, lambda cr: draw_darrow(cr,-45))
        b_static("grab", 16, 16, draw_cross)
        b_static("grabbing", 16, 16, draw_cross)
        b_static("not_allowed", 16, 16, draw_cross)
        b_anim("watch", 16, 16, False)
        b_anim("left_ptr_watch", 3, 2, True)

        aliases = {
            "left_ptr": ["default","arrow","top_left_arrow","right_ptr","help","context-menu","copy"],
            "hand2": ["pointer","hand1","pointing_hand"],
            "xterm": ["text","ibeam"],
            "crosshair": ["cross","tcross","plus","color-picker"],
            "fleur": ["move","size_all","all-scroll"],
            "sb_h_double_arrow": ["ew-resize","col-resize","size_hor","left_side","right_side","e-resize","w-resize"],
            "sb_v_double_arrow": ["ns-resize","row-resize","size_ver","top_side","bottom_side","n-resize","s-resize"],
            "bd_double_arrow": ["nwse-resize","size_fdiag","top_left_corner","bottom_right_corner","nw-resize","se-resize"],
            "fd_double_arrow": ["nesw-resize","size_bdiag","top_right_corner","bottom_left_corner","ne-resize","sw-resize"],
            "grab": ["openhand"],
            "grabbing": ["closedhand","dnd-move","dnd-copy"],
            "not_allowed": ["not-allowed","crossed_circle","no-drop","forbidden"],
            "watch": ["wait"],
            "left_ptr_watch": ["progress","half-busy"],
        }
        for tgt, lks in aliases.items():
            for lk in lks:
                lp = os.path.join(cursors_dir, lk)
                if not os.path.exists(lp): os.symlink(tgt, lp)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    shutil.copytree(theme_dir, os.path.join(icons_root, "CyberDeck-Cursor"))

    for d_idx in (os.path.join(HOME, ".icons/default/index.theme"), os.path.join(HOME, ".local/share/icons/default/index.theme")):
        os.makedirs(os.path.dirname(d_idx), exist_ok=True)
        open(d_idx, "w", encoding="utf-8").write(f"[Icon Theme]\nName=Default\nInherits={cur_name}\n")

    open(os.path.join(HOME, ".Xresources"), "w", encoding="utf-8").write(f"Xcursor.theme: {cur_name}\nXcursor.size: 28\n")
    subprocess.run(["xrdb", "-merge", os.path.join(HOME, ".Xresources")], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    for gdir in (os.path.join(HOME, ".config/gtk-3.0"), os.path.join(HOME, ".config/gtk-4.0")):
        os.makedirs(gdir, exist_ok=True)
        open(os.path.join(gdir, "settings.ini"), "w", encoding="utf-8").write(
            f"[Settings]\ngtk-application-prefer-dark-theme=1\ngtk-cursor-theme-name={cur_name}\ngtk-cursor-theme-size=28\ngtk-icon-theme-name=CyberDeck-Icons\ngtk-font-name=Noto Sans 10\n"
        )

    open(os.path.join(HOME, ".config/environment.d/99-cyberdeck.conf"), "w", encoding="utf-8").write(f"XCURSOR_THEME={cur_name}\nXCURSOR_SIZE=28\n")
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", "Adwaita"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", cur_name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["hyprctl", "--batch", f"keyword env XCURSOR_THEME,{cur_name} ; setcursor {cur_name} 28"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return cur_name

def update_terminals(t):
    p_hex, a_hex, s_hex, bg_hex, bg_alt, fg_hex = t["primary"], t["accent"], t["soft"], t["bg"], t["bg_alt"], t["fg"]
    p_c, a_c, s_c, bg_c, bg_ac, fg_c = p_hex.lstrip("#"), a_hex.lstrip("#"), s_hex.lstrip("#"), bg_hex.lstrip("#"), bg_alt.lstrip("#"), fg_hex.lstrip("#")
    pr, pg, pb = hex_rgb_int(p_hex)
    ar, ag, ab = hex_rgb_int(a_hex)
    sr, sg_i, sb = hex_rgb_int(s_hex)
    sym = t["symbol"]
    short = t["short"].upper()

    open(os.path.join(HOME, ".config/foot/foot.ini"), "w", encoding="utf-8").write(f"""[main]
font=monospace:size=11.5
pad=18x14 center
initial-color-theme=dark

[cursor]
style=beam
blink=no

[csd]
preferred=none

[colors-dark]
alpha=1.0
background={bg_c}
foreground={fg_c}
cursor={bg_c} {a_c}
selection-foreground=f0f4ff
selection-background={bg_ac}
urls={a_c}

regular0={bg_c}
regular1=ff6b6b
regular2=20c997
regular3=fcc419
regular4={p_c}
regular5={s_c}
regular6={a_c}
regular7={fg_c}

bright0=495678
bright1=ff8787
bright2=63e6be
bright3=ffe066
bright4={p_c}
bright5={s_c}
bright6={a_c}
bright7=ffffff
""")

    osc_seq = (
        f"\033]11;{bg_hex}\007\033]10;{fg_hex}\007\033]12;{a_hex}\007"
        f"\033]4;0;{bg_hex}\007\033]4;4;{p_hex}\007\033]4;5;{s_hex}\007\033]4;6;{a_hex}\007"
        f"\033]4;12;{p_hex}\007\033]4;13;{s_hex}\007\033]4;14;{a_hex}\007"
    )
    uid = os.getuid()
    for pts in glob.glob("/dev/pts/[0-9]*"):
        try:
            if os.stat(pts).st_uid == uid:
                with open(pts, "wb", buffering=0) as f:
                    f.write(osc_seq.encode("ascii"))
        except Exception:
            pass

def apply_backend(theme_id, restart_hub=True):
    if theme_id not in THEMES:
        theme_id = "cyberdeck"
    t = THEMES[theme_id]
    p_hex, a_hex, bg_hex = t["primary"], t["accent"], t["bg"]
    cur_name = f"CyberDeck-Cursor-{theme_id}"

    state_payload = {"id": theme_id, "cursor_theme": cur_name, **t}
    json.dump(state_payload, open(STATE_FILE, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
    json.dump(state_payload, open(WORK_STATE, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
    json.dump(state_payload, open(GAME_STATE, "w", encoding="utf-8"), indent=2, ensure_ascii=False)

    open(os.path.join(CFG_DIR, "active_hub.css"), "w", encoding="utf-8").write(build_full_theme_css(t))

    all_prim = ("#4c6ef5","#3b5bdb","#e03131","#d93829","#f02e3e","#0ca678","#2d6a4f","#e07a5f","#478cbf","#d63384","#f03e98","#1c7ed6","#339af0","#364fc7")
    all_acc  = ("#22b8cf","#00f5d4","#fcc419","#f5b82e","#ffb800","#38d9a9","#74c69d","#f2cc8f","#63d994","#40f99b","#20c997","#74c0fc","#99e9f2","#66d9e8")

    for svg_f in glob.glob(os.path.join(HOME, ".config/hypr/assets/ui/*.svg")):
        stxt = open(svg_f, "r", encoding="utf-8").read()
        stxt = re.sub(r"#[0-9a-fA-F]{6}", lambda m: (p_hex if m.group(0).lower() in all_prim else (a_hex if m.group(0).lower() in all_acc else m.group(0))), stxt)
        open(svg_f, "w", encoding="utf-8").write(stxt)

    for script_p in (os.path.join(HOME, ".local/bin/cyber-icons-sync"), os.path.join(HOME, ".local/bin/cyber-firefox-sync")):
        if os.path.isfile(script_p):
            txt = open(script_p, "r", encoding="utf-8").read()
            txt = re.sub(r"#[0-9a-fA-F]{6}", lambda m: (p_hex if m.group(0).lower() in all_prim else (a_hex if m.group(0).lower() in all_acc else m.group(0))), txt)
            open(script_p, "w", encoding="utf-8").write(txt)

    subprocess.run(["/usr/bin/python3", os.path.join(HOME, ".local/bin/cyber-icons-sync")], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["/usr/bin/python3", os.path.join(HOME, ".local/bin/cyber-firefox-sync")], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    render_world_wallpaper(t)
    update_terminals(t)
    rebuild_world_cursor(theme_id, t)

    for rasi_p in (os.path.join(HOME, ".config/hypr/gaming_launcher.rasi"), os.path.join(HOME, ".config/hypr/cyber_wifi.rasi")):
        if os.path.isfile(rasi_p):
            rtxt = open(rasi_p, "r", encoding="utf-8").read()
            rtxt = re.sub(r"cyan:\s*#[0-9a-fA-F]{6};", f"cyan:        {a_hex};", rtxt)
            rtxt = re.sub(r"indigo:\s*#[0-9a-fA-F]{6};", f"indigo:      {p_hex};", rtxt)
            rtxt = re.sub(r"bg:\s*#[0-9a-fA-F]{6};", f"bg:          {bg_hex};", rtxt)
            open(rasi_p, "w", encoding="utf-8").write(rtxt)

    p_c, a_c = p_hex.lstrip("#"), a_hex.lstrip("#")
    h_round = int(t["hypr_round"])
    for hconf in glob.glob(os.path.join(HOME, ".config/hypr/*.conf")):
        htxt = open(hconf, "r", encoding="utf-8").read()
        htxt = re.sub(r"col\.active_border\s*=\s*.*", f"col.active_border = rgba({p_c}ff) rgba({a_c}ff) 45deg", htxt)
        htxt = re.sub(r"rounding\s*=\s*\d+", f"rounding = {h_round}", htxt)
        htxt = re.sub(r"env\s*=\s*XCURSOR_THEME,.*", f"env = XCURSOR_THEME,{cur_name}", htxt)
        htxt = re.sub(r"exec-once\s*=\s*hyprctl setcursor .*", f"exec-once = hyprctl setcursor {cur_name} 28", htxt)
        open(hconf, "w", encoding="utf-8").write(htxt)

    subprocess.run([
        "hyprctl", "--batch",
        f"keyword general:col.active_border rgba({p_c}ff) rgba({a_c}ff) 45deg ; keyword decoration:rounding {h_round} ; keyword env XCURSOR_THEME,{cur_name} ; setcursor {cur_name} 28"
    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    subprocess.run(["sudo", "-n", "/usr/local/bin/cyber-theme-sys-sync", HOME, p_hex, a_hex, cur_name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["makoctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    if restart_hub:
        in_game = is_gaming_session()
        target_py = "game-hub-desktop.py" if in_game else "work-hub-desktop.py"
        target_ns = "gaming-hub-wallpaper" if in_game else "work-hub-wallpaper"

        for old_proc in ("work-hub-desktop.py", "game-hub-desktop.py", "cyberdeck-hub-desktop.py"):
            subprocess.run(["pkill", "-9", "-f", old_proc], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        for _ in range(30):
            if subprocess.call(["pgrep", "-f", "hub-desktop.py"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
                break
            time.sleep(0.04)

        env = os.environ.copy()
        env["XCURSOR_THEME"] = cur_name
        env["XCURSOR_SIZE"] = "28"
        if os.path.isfile("/usr/lib/libgtk4-layer-shell.so"):
            env["LD_PRELOAD"] = "/usr/lib/libgtk4-layer-shell.so"
        subprocess.Popen(["/usr/bin/python3", os.path.join(HOME, ".local/bin", target_py)], env=env, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        for _ in range(40):
            try:
                if target_ns in subprocess.check_output(["hyprctl", "layers", "-j"], text=True, stderr=subprocess.DEVNULL):
                    break
            except Exception:
                pass
            time.sleep(0.05)

def show_menu():
    # Закрываем любой зависший экземпляр rofi, чтобы меню открывалось с первого клика
    subprocess.run(["pkill", "-x", "rofi"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    cur = load_current()
    lines, id_map = [], {}
    for tid, meta in THEMES.items():
        mark = "   [● АКТИВНА]" if tid == cur else ""
        row = f"{meta['title']}{mark}"
        lines.append(row)
        id_map[row] = tid

    cmd = ["rofi", "-dmenu", "-i", "-p", "◈ ВЫБОР МИРА / ОКРУЖЕНИЯ (5 ТЕМ)"]
    if os.path.isfile(ROFI_WIFI):
        cmd += ["-theme", ROFI_WIFI]

    proc = subprocess.run(cmd, input="
".join(lines), text=True, capture_output=True)
    if proc.returncode != 0 and os.path.isfile(ROFI_WIFI):
        # Fallback на случай ошибки темы Rofi
        proc = subprocess.run(["rofi", "-dmenu", "-i", "-p", "◈ ВЫБОР МИРА"], input="
".join(lines), text=True, capture_output=True)

    ch = proc.stdout.strip()
    if proc.returncode == 0 and ch in id_map:
        new_id = id_map[ch]
        launch_world_transition(cur, new_id)

def launch_world_transition(cur_id, new_id):
    env = os.environ.copy()
    if os.path.isfile("/usr/lib/libgtk4-layer-shell.so"):
        env["LD_PRELOAD"] = "/usr/lib/libgtk4-layer-shell.so"
    subprocess.Popen(
        ["/usr/bin/python3", os.path.join(HOME, ".local/bin/cyber-theme-anim.py"), cur_id, new_id],
        env=env,
        start_new_session=True,
        stdout=open("/tmp/cyber-theme-anim.log", "w"),
        stderr=subprocess.STDOUT,
    )

if __name__ == "__main__":
    act = sys.argv[1] if len(sys.argv) > 1 else "menu"
    if act == "--apply-backend" and len(sys.argv) > 2:
        apply_backend(sys.argv[2], restart_hub=True)
    elif act == "apply" and len(sys.argv) > 2:
        launch_world_transition(load_current(), sys.argv[2])
    elif act == "--sync-session":
        apply_backend(load_current(), restart_hub=False)
    elif act == "get":
        print(THEMES[load_current()]["short"])
    else:
        show_menu()
