def render_cyberdeck_variant_bg(t):
    # Каждая тема строится на фирменном HUD-чертеже CyberDeck (сетка + угловые скобы + шевроны),
    # но имеет уникальный центральный/боковой модуль своей серии
    W, H = 1920, 1080
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, W, H)
    cr = cairo.Context(surf)
    PRIM, ACC, BG = hex_rgb(t["primary"]), hex_rgb(t["accent"]), hex_rgb(t["bg"])
    arch = t["arch"]

    cr.set_source_rgb(*BG); cr.paint()

    # 1. Фирменные угловые неоновые ореолы CyberDeck
    for cx, cy, rad, col, al in [(W*0.15, H*0.14, 620, PRIM, 0.12), (W*0.85, H*0.86, 620, ACC, 0.10)]:
        rg = cairo.RadialGradient(cx, cy, 10, cx, cy, rad)
        rg.add_color_stop_rgba(0, *col, al); rg.add_color_stop_rgba(1, *col, 0)
        cr.set_source(rg); cr.paint()

    # 2. Фирменная двойная инженерная сетка (24px + 96px с перекрестиями)
    cr.set_line_width(1.0); cr.set_source_rgba(*PRIM, 0.025)
    for x in range(24, W, 24): cr.move_to(x, 0); cr.line_to(x, H)
    for y in range(24, H, 24): cr.move_to(0, y); cr.line_to(W, y)
    cr.stroke()

    cr.set_source_rgba(*PRIM, 0.065)
    for x in range(96, W, 96): cr.move_to(x, 0); cr.line_to(x, H)
    for y in range(96, H, 96): cr.move_to(0, y); cr.line_to(W, y)
    cr.stroke()

    cr.set_source_rgba(*ACC, 0.18)
    for x in range(192, W - 60, 192):
        for y in range(192, H - 60, 192):
            cr.move_to(x - 4, y); cr.line_to(x + 4, y)
            cr.move_to(x, y - 4); cr.line_to(x, y + 4)
    cr.stroke()

    # 3. Индивидуальный HUD-узор конкретной темы поверх базового чертежа
    if arch == "tactical":
        for rx, ry, rr in [(W*0.82, H*0.56, 195), (W*0.16, H*0.64, 145)]:
            cr.set_line_width(1.2); cr.set_source_rgba(*PRIM, 0.14)
            cr.arc(rx, ry, rr, 0, 2*math.pi); cr.stroke()
            cr.set_line_width(2.4); cr.set_source_rgba(*ACC, 0.24)
            cr.arc(rx, ry, rr * 1.1, -0.5, 0.6); cr.stroke()
    elif arch == "ronin":
        # Диагональные силовые векторы и ромбовидный узел Ronin
        for rx, ry, rr in [(W*0.82, H*0.56, 190), (W*0.16, H*0.64, 140)]:
            cr.set_line_width(1.8); cr.set_source_rgba(*PRIM, 0.20)
            cr.move_to(rx, ry - rr); cr.line_to(rx + rr, ry); cr.line_to(rx, ry + rr); cr.line_to(rx - rr, ry); cr.close_path(); cr.stroke()
            cr.set_line_width(2.2); cr.set_source_rgba(*ACC, 0.25)
            cr.move_to(rx - rr*1.2, ry); cr.line_to(rx + rr*1.2, ry); cr.stroke()
    elif arch == "matrix":
        # Гексагональные узлы и тонкие вертикальные трассы данных
        random.seed(42)
        cr.set_line_width(1.4)
        for x in range(96, W, 96):
            y0 = random.randint(80, H - 380)
            hlen = random.randint(140, 280)
            lg = cairo.LinearGradient(x, y0, x, y0 + hlen)
            lg.add_color_stop_rgba(0, *PRIM, 0.0); lg.add_color_stop_rgba(1, *ACC, 0.24)
            cr.set_source(lg); cr.move_to(x, y0); cr.line_to(x, y0 + hlen); cr.stroke()
        for rx, ry, rr in [(W*0.82, H*0.56, 180), (W*0.16, H*0.64, 135)]:
            cr.set_line_width(1.6); cr.set_source_rgba(*ACC, 0.22)
            cr.new_sub_path()
            for i in range(6):
                ang = math.pi/3 * i + math.pi/6
                cr.line_to(rx + rr*math.cos(ang), ry + rr*math.sin(ang))
            cr.close_path(); cr.stroke()
    elif arch == "synth":
        # Двойные неоновые дуги и перспективные лучи в нижней части чертежа
        for rx, ry, rr in [(W*0.82, H*0.56, 195), (W*0.16, H*0.64, 145)]:
            cr.set_line_width(2.0); cr.set_source_rgba(*PRIM, 0.22)
            cr.arc(rx, ry, rr, math.pi, 2*math.pi); cr.stroke()
            cr.set_source_rgba(*ACC, 0.24)
            cr.arc(rx, ry, rr * 0.82, 0, math.pi); cr.stroke()
    elif arch == "cryo":
        # Крио-кольца астролябии с градуировкой
        for rx, ry, rr in [(W*0.82, H*0.56, 195), (W*0.16, H*0.64, 145)]:
            cr.set_line_width(1.3); cr.set_source_rgba(*ACC, 0.22)
            cr.arc(rx, ry, rr, 0, 2*math.pi); cr.stroke()
            for deg in range(0, 360, 30):
                a = math.radians(deg)
                cr.move_to(rx + (rr-8)*math.cos(a), ry + (rr-8)*math.sin(a))
                cr.line_to(rx + (rr+8)*math.cos(a), ry + (rr+8)*math.sin(a))
            cr.stroke()

    # 4. Фирменные периметральные скобы и шевроны CyberDeck
    m, ln = 14, 52
    cr.set_line_width(2.4); cr.set_source_rgba(*PRIM, 0.75)
    for x1, y1, x2, y2, x3, y3 in [
        (m, m + ln, m, m, m + ln, m), (W - m - ln, m, W - m, m, W - m, m + ln),
        (m, H - m - ln, m, H - m, m + ln, H - m), (W - m - ln, H - m, W - m, H - m, W - m, H - m - ln),
    ]:
        cr.move_to(x1, y1); cr.line_to(x2, y2); cr.line_to(x3, y3)
    cr.stroke()

    cr.set_line_width(2.2); cr.set_source_rgba(*ACC, 0.42)
    for i in range(12):
        ox = 84 + i * 11
        cr.move_to(ox, m); cr.line_to(ox + 7, m + 7)
        bx = W - 216 + i * 11
        cr.move_to(bx, H - m - 7); cr.line_to(bx + 7, H - m)
    cr.stroke()

    for nm in ("work_hud_bg.png", "gaming_hud_bg.png", "cyberdeck_hud_bg.png", "sddm_bg.png", "lock_hud_bg.png"):
        surf.write_to_png(os.path.join(CACHE_DIR, nm))
    surf.write_to_png(os.path.join(HOME, ".config/hypr/assets/terminal_hud_bg.png"))

def rebuild_cursor_and_flush_cache(theme_id, t):
    # Создаём папку с УНИКАЛЬНЫМ именем темы курсора, чтобы Hyprland и GTK4 мгновенно сбросили кэш!
    cur_name = f"CyberDeck-Cursor-{theme_id}"
    icons_root = os.path.join(HOME, ".local/share/icons")
    # Удаляем старые тематические папки курсора
    for old_d in glob.glob(os.path.join(icons_root, "CyberDeck-Cursor*")):
        shutil.rmtree(old_d, ignore_errors=True)

    theme_dir = os.path.join(icons_root, cur_name)
    cursors_dir = os.path.join(theme_dir, "cursors")
    os.makedirs(cursors_dir, exist_ok=True)
    open(os.path.join(theme_dir, "index.theme"), "w", encoding="utf-8").write(
        f"[Icon Theme]\nName={cur_name}\nComment=CyberDeck {t['short']} Cursor\nInherits=Adwaita\n"
    )

    PRIM, ACC, DARK, FG = hex_rgb(t["primary"]), hex_rgb(t["accent"]), hex_rgb(t["bg"]), hex_rgb(t["fg"])
    arch = t["arch"]

    def new_surf(sz):
        s = cairo.ImageSurface(cairo.FORMAT_ARGB32, sz, sz)
        cr = cairo.Context(s); cr.scale(sz / 32.0, sz / 32.0)
        cr.set_line_cap(cairo.LINE_CAP_ROUND); cr.set_line_join(cairo.LINE_JOIN_ROUND)
        return s, cr

    def draw_arrow(cr):
        if arch == "ronin":
            pts = [(3, 2), (3, 25), (8.5, 19.5), (13.5, 28), (17.0, 26.2), (12.0, 17.8), (20.5, 16.5)]
        elif arch == "matrix":
            pts = [(3, 2), (3, 24), (8.8, 19.2), (12.6, 27.5), (16.0, 25.8), (12.2, 17.6), (19.8, 17.6)]
        elif arch == "synth":
            pts = [(3, 2), (4.2, 24.5), (9.8, 19.0), (14.5, 27.0), (17.8, 25.0), (13.0, 17.2), (20.5, 16.0)]
        else:
            pts = [(3, 2), (3, 24), (8.8, 19.2), (12.6, 27.5), (16.0, 25.8), (12.2, 17.6), (19.8, 17.6)]

        cr.save(); cr.translate(1.2, 1.5); cr.move_to(*pts[0])
        for p in pts[1:]: cr.line_to(*p)
        cr.close_path(); cr.set_source_rgba(0, 0, 0, 0.50); cr.fill(); cr.restore()

        cr.move_to(*pts[0])
        for p in pts[1:]: cr.line_to(*p)
        cr.close_path()
        cr.set_source_rgba(*DARK, 0.96); cr.fill_preserve()

        lg = cairo.LinearGradient(3, 2, 20, 27)
        lg.add_color_stop_rgb(0.0, *ACC); lg.add_color_stop_rgb(0.6, *PRIM); lg.add_color_stop_rgb(1.0, *ACC)
        cr.set_source(lg); cr.set_line_width(2.0); cr.stroke()

        # Акцентное ядро внутри стрелки
        cr.arc(5.2, 6.2, 1.5, 0, 2*math.pi); cr.set_source_rgb(*ACC); cr.fill()

    def draw_pointer(cr):
        pts = [(6,5),(6,23),(11.2,18.8),(15.5,26),(18.5,24.4),(14.2,17.2),(21,17.2)]
        cr.move_to(*pts[0])
        for p in pts[1:]: cr.line_to(*p)
        cr.close_path(); cr.set_source_rgba(*DARK, 0.96); cr.fill_preserve()
        cr.set_source_rgb(*ACC); cr.set_line_width(1.9); cr.stroke()
        cx, cy, r = 6.0, 5.0, 3.6
        cr.move_to(cx, cy-r); cr.line_to(cx+r, cy); cr.line_to(cx, cy+r); cr.line_to(cx-r, cy); cr.close_path()
        cr.set_source_rgba(*PRIM, 0.95); cr.fill_preserve(); cr.set_source_rgb(*FG); cr.set_line_width(1.3); cr.stroke()

    def draw_ibeam(cr):
        for w, col, al in [(4.2,(0,0,0),0.65), (2.0,ACC,1.0)]:
            cr.set_line_width(w); cr.set_source_rgba(*col, al)
            cr.move_to(16,5); cr.line_to(16,27); cr.move_to(11.5,5); cr.line_to(20.5,5); cr.move_to(11.5,27); cr.line_to(20.5,27); cr.stroke()

    def draw_cross(cr):
        cr.set_line_width(1.9); cr.set_source_rgb(*ACC)
        for x1,y1,x2,y2 in [(16,3,16,11),(16,21,16,29),(3,16,11,16),(21,16,29,16)]: cr.move_to(x1,y1); cr.line_to(x2,y2)
        cr.stroke()
        cr.set_line_width(1.4); cr.set_source_rgb(*PRIM); cr.arc(16,16,6.5,0,2*math.pi); cr.stroke()

    def draw_darrow(cr, ang):
        cr.save(); cr.translate(16,16); cr.rotate(math.radians(ang))
        cr.set_line_width(2.2); cr.set_source_rgb(*ACC)
        cr.move_to(-10,0); cr.line_to(10,0); cr.move_to(-6,-4.5); cr.line_to(-11,0); cr.line_to(-6,4.5); cr.move_to(6,-4.5); cr.line_to(11,0); cr.line_to(6,4.5); cr.stroke()
        cr.restore()

    def draw_spin(cr, ph, mini=False):
        cx, cy, r = (22.5, 21.5, 6.2) if mini else (16.0, 16.0, 10.5)
        cr.arc(cx,cy,r,0,2*math.pi); cr.set_source_rgba(*DARK,0.88); cr.fill()
        a0 = ph * 2 * math.pi
        cr.set_line_width(2.4); cr.set_source_rgb(*ACC); cr.arc(cx,cy,r,a0,a0+math.pi*0.9); cr.stroke()
        cr.set_source_rgb(*PRIM); cr.arc(cx,cy,r,a0+math.pi,a0+math.pi*1.55); cr.stroke()

    tmp = tempfile.mkdtemp(prefix="cd_cur_")
    try:
        sizes = [24, 32, 48]
        def b_static(name, hx32, hy32, fn):
            lines = []
            for sz in sizes:
                s, cr = new_surf(sz); fn(cr)
                png = os.path.join(tmp, f"{name}_{sz}.png"); s.write_to_png(png)
                lines.append(f"{sz} {int(round(hx32*sz/32.0))} {int(round(hy32*sz/32.0))} {png}")
            cfg = os.path.join(tmp, f"{name}.cfg"); open(cfg,"w").write("\n".join(lines)+"\n")
            subprocess.run(["xcursorgen", cfg, os.path.join(cursors_dir, name)], check=True)
        def b_anim(name, hx32, hy32, mini=False):
            lines = []
            for sz in sizes:
                for fr in range(10):
                    s, cr = new_surf(sz)
                    if mini: draw_arrow(cr)
                    draw_spin(cr, fr/10.0, mini)
                    png = os.path.join(tmp, f"{name}_{sz}_{fr}.png"); s.write_to_png(png)
                    lines.append(f"{sz} {int(round(hx32*sz/32.0))} {int(round(hy32*sz/32.0))} {png} 60")
            cfg = os.path.join(tmp, f"{name}.cfg"); open(cfg,"w").write("\n".join(lines)+"\n")
            subprocess.run(["xcursorgen", cfg, os.path.join(cursors_dir, name)], check=True)

        b_static("left_ptr", 3, 2, draw_arrow)
        b_static("hand2", 6, 5, draw_pointer)
        b_static("xterm", 16, 16, draw_ibeam)
        b_static("crosshair", 16, 16, draw_cross)
        b_static("fleur", 16, 16, lambda cr: (draw_darrow(cr,0), draw_darrow(cr,90)))
        b_static("sb_h_double_arrow", 16, 16, lambda cr: draw_darrow(cr,0))
        b_static("sb_v_double_arrow", 16, 16, lambda cr: draw_darrow(cr,90))
        b_static("bd_double_arrow", 16, 16, lambda cr: draw_darrow(cr,45))
        b_static("fd_double_arrow", 16, 16, lambda cr: draw_darrow(cr,-45))
        b_static("grab", 16, 16, draw_cross)
        b_static("grabbing", 16, 16, draw_cross)
        b_static("not_allowed", 16, 16, draw_cross)
        b_anim("watch", 16, 16, False)
        b_anim("left_ptr_watch", 3, 2, True)

        aliases = {
            "left_ptr": ["default","arrow","top_left_arrow","right_ptr","help","context-menu","copy"],
            "hand2": ["pointer","hand1","pointing_hand"],
            "xterm": ["text","ibeam"],
            "crosshair": ["cross","tcross","plus","color-picker"],
            "fleur": ["move","size_all","all-scroll"],
            "sb_h_double_arrow": ["ew-resize","col-resize","size_hor","left_side","right_side","e-resize","w-resize"],
            "sb_v_double_arrow": ["ns-resize","row-resize","size_ver","top_side","bottom_side","n-resize","s-resize"],
            "bd_double_arrow": ["nwse-resize","size_fdiag","top_left_corner","bottom_right_corner","nw-resize","se-resize"],
            "fd_double_arrow": ["nesw-resize","size_bdiag","top_right_corner","bottom_left_corner","ne-resize","sw-resize"],
            "grab": ["openhand"],
            "grabbing": ["closedhand","dnd-move","dnd-copy"],
            "not_allowed": ["not-allowed","crossed_circle","no-drop","forbidden"],
            "watch": ["wait"],
            "left_ptr_watch": ["progress","half-busy"],
        }
        for tgt, lks in aliases.items():
            for lk in lks:
                lp = os.path.join(cursors_dir, lk)
                if not os.path.exists(lp): os.symlink(tgt, lp)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    # Дублируем в базовое имя CyberDeck-Cursor для совместимости
    shutil.copytree(theme_dir, os.path.join(icons_root, "CyberDeck-Cursor"))

    # Обновляем локальные index.theme, GTK3/4, Xresources и GSettings на новое уникальное имя cur_name
    for d_idx in (os.path.join(HOME, ".icons/default/index.theme"), os.path.join(HOME, ".local/share/icons/default/index.theme")):
        os.makedirs(os.path.dirname(d_idx), exist_ok=True)
        open(d_idx, "w", encoding="utf-8").write(f"[Icon Theme]\nName=Default\nInherits={cur_name}\n")

    open(os.path.join(HOME, ".Xresources"), "w", encoding="utf-8").write(f"Xcursor.theme: {cur_name}\nXcursor.size: 28\n")
    subprocess.run(["xrdb", "-merge", os.path.join(HOME, ".Xresources")], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    for gdir in (os.path.join(HOME, ".config/gtk-3.0"), os.path.join(HOME, ".config/gtk-4.0")):
        os.makedirs(gdir, exist_ok=True)
        open(os.path.join(gdir, "settings.ini"), "w", encoding="utf-8").write(
            f"[Settings]\ngtk-application-prefer-dark-theme=1\ngtk-cursor-theme-name={cur_name}\ngtk-cursor-theme-size=28\ngtk-icon-theme-name=CyberDeck-Icons\ngtk-font-name=Noto Sans 10\n"
        )

    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", cur_name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["hyprctl", "setcursor", cur_name, "28"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return cur_name

def update_all_terminals_live(t):
    p_hex, a_hex, s_hex, bg_hex, bg_alt, fg_hex = t["primary"], t["accent"], t["soft"], t["bg"], t["bg_alt"], t["fg"]
    p_c, a_c, s_c, bg_c, bg_ac, fg_c = p_hex.lstrip("#"), a_hex.lstrip("#"), s_hex.lstrip("#"), bg_hex.lstrip("#"), bg_alt.lstrip("#"), fg_hex.lstrip("#")
    pr, pg, pb = hex_rgb_int(p_hex)
    ar, ag, ab = hex_rgb_int(a_hex)
    sr, sg_i, sb = hex_rgb_int(s_hex)
    sym = t["symbol"]
    short = t["short"].upper()

    # 1. Полностью обновляем ~/.config/foot/foot.ini
    foot_ini = f"""[main]
font=monospace:size=11.5
pad=18x14 center
initial-color-theme=dark

[cursor]
style=beam
blink=no

[csd]
preferred=none

[colors-dark]
alpha=1.0
background={bg_c}
foreground={fg_c}
cursor={bg_c} {a_c}
selection-foreground=f0f4ff
selection-background={bg_ac}
urls={a_c}

regular0={bg_c}
regular1=ff6b6b
regular2=20c997
regular3=fcc419
regular4={p_c}
regular5={s_c}
regular6={a_c}
regular7={fg_c}

bright0=495678
bright1=ff8787
bright2=63e6be
bright3=ffe066
bright4={p_c}
bright5={s_c}
bright6={a_c}
bright7=ffffff
"""
    os.makedirs(os.path.join(HOME, ".config/foot"), exist_ok=True)
    open(os.path.join(HOME, ".config/foot/foot.ini"), "w", encoding="utf-8").write(foot_ini)

    # 2. Обновляем ~/.config/kitty/cyber-deck.conf
    kitty_conf = f"""background {bg_hex}
foreground {fg_hex}
cursor {a_hex}
cursor_text_color {bg_hex}
selection_background {bg_alt}
selection_foreground #ffffff
color0 {bg_hex}
color4 {p_hex}
color6 {a_hex}
color12 {p_hex}
color14 {a_hex}
background_opacity 1.0
background_image {HOME}/.config/hypr/assets/terminal_hud_bg.png
background_image_layout scaled
"""
    os.makedirs(os.path.join(HOME, ".config/kitty"), exist_ok=True)
    open(os.path.join(HOME, ".config/kitty/cyber-deck.conf"), "w", encoding="utf-8").write(kitty_conf)
    subprocess.run(["pkill", "-USR1", "-x", "kitty"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 3. Обновляем HUD-рельсу и промпт ~/.config/cyberdeck/cyber-shell.sh с RGB-цветами выбранной темы!
    shell_sh = f"""unset LD_PRELOAD
case $- in
    *i*) ;;
    *) return ;;
esac

__cyber_deck_mode() {{
    if [[ "${{HYPRLAND_CONFIG:-}}" == *"game"* ]]; then
        printf "GAME"
    else
        printf "{short}"
    fi
}}

__cyber_print_hud_rail() {{
    local ec=$?
    local cols=$(( ${{COLUMNS:-$(tput cols 2>/dev/null || echo 80)}} - 1 ))
    [ "$cols" -lt 44 ] && cols=44

    local mode
    mode=$(__cyber_deck_mode)
    local dir="${{PWD/#$HOME/\\~}}"
    [ "${{#dir}}" -gt 32 ] && dir="…${{dir: -31}}"

    local git_b=""
    if [ -d .git ] || git rev-parse --git-dir >/dev/null 2>&1; then
        git_b=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
    fi

    local t_now
    t_now=$(date +%H:%M)
    local st_plain="OK"
    [ "$ec" -ne 0 ] && st_plain="ERR:$ec"

    local left_plain="╭─{sym} [CYBER//${{mode}} ∷ ${{USER}}]─[${{dir}}]"
    [ -n "$git_b" ] && left_plain="${{left_plain}}─[⎇ ${{git_b}}]"
    local right_plain="[${{st_plain}} • ${{t_now}}]─╮"

    local fill_len=$(( cols - ${{#left_plain}} - ${{#right_plain}} ))
    [ "$fill_len" -lt 2 ] && fill_len=2

    local C_IND="\\e[38;2;{pr};{pg};{pb}m"
    local C_DIM="\\e[38;2;{max(15, pr//2)};{max(15, pg//2)};{max(15, pb//2)}m"
    local C_CYN="\\e[1;38;2;{ar};{ag};{ab}m"
    local C_TXT="\\e[1;38;2;240;244;255m"
    local C_PTH="\\e[1;38;2;{sr};{sg_i};{sb}m"
    local C_GRN="\\e[1;38;2;99;230;190m"
    local C_RED="\\e[1;38;2;255;107;107m"
    local C_RST="\\e[0m"

    local middle=""
    if [ "$fill_len" -ge 12 ]; then
        local l_pad=$(( (fill_len - 8) / 2 ))
        local r_pad=$(( fill_len - 8 - l_pad ))
        local seg_l seg_r
        printf -v seg_l '%*s' "$l_pad" ''; seg_l="${{seg_l// /─}}"
        printf -v seg_r '%*s' "$r_pad" ''; seg_r="${{seg_r// /─}}"
        middle="${{C_DIM}}${{seg_l}}${{C_CYN}} ////// ${{C_DIM}}${{seg_r}}"
    else
        printf -v middle '%*s' "$fill_len" ''; middle="${{C_DIM}}${{middle// /─}}"
    fi

    local git_col=""
    [ -n "$git_b" ] && git_col="${{C_IND}}─[${{C_GRN}}⎇ ${{git_b}}${{C_IND}}]"

    local st_col="${{C_GRN}}OK"
    [ "$ec" -ne 0 ] && st_col="${{C_RED}}ERR:${{ec}}"

    printf "\\n${{C_IND}}╭─${{C_CYN}}{sym}${{C_IND}} [${{C_CYN}}CYBER//${{mode}}${{C_IND}} ∷ ${{C_TXT}}${{USER}}${{C_IND}}]─[${{C_PTH}}${{dir}}${{C_IND}}]${{git_col}}${{middle}}${{C_IND}}[${{st_col}}${{C_IND}} • ${{C_TXT}}${{t_now}}${{C_IND}}]─╮${{C_RST}}\\n"
    return "$ec"
}}

if [ -n "${{BASH_VERSION:-}}" ]; then
    __cyber_prompt_cmd() {{
        local ec=$?
        (exit "$ec")
        __cyber_print_hud_rail
        if [ "$ec" -eq 0 ]; then
            PS1="\\[\\e[38;2;{pr};{pg};{pb}m\\]╰─\\[\\e[1;38;2;{ar};{ag};{ab}m\\]{sym} ⟫\\[\\e[0m\\] "
        else
            PS1="\\[\\e[38;2;{pr};{pg};{pb}m\\]╰─\\[\\e[1;38;2;255;107;107m\\]✘ ⟫\\[\\e[0m\\] "
        fi
    }}
    PROMPT_COMMAND="__cyber_prompt_cmd"
elif [ -n "${{ZSH_VERSION:-}}" ]; then
    precmd() {{ __cyber_print_hud_rail; }}
    setopt PROMPT_SUBST
    PROMPT='%F{{{p_hex}}}╰─%(?.%B%F{{{a_hex}}}{sym} ⟫.%B%F{{#ff6b6b}}✘ ⟫)%b%f '
fi

if [ -z "${{CYBER_BANNER_SHOWN:-}}" ] && [ "${{SHLVL:-1}}" -le 2 ]; then
    export CYBER_BANNER_SHOWN=1
    printf "\\e[38;2;{pr};{pg};{pb}m┏━━\\e[1;38;2;{ar};{ag};{ab}m{sym} CYBERDECK // {short} CONSOLE\\e[0m\\e[38;2;{pr};{pg};{pb}m━━┫ \\e[38;2;{sr};{sg_i};{sb}mSYS.NODE // %s\\e[38;2;{pr};{pg};{pb}m ┣━━\\e[38;2;{ar};{ag};{ab}m//////\\e[38;2;{pr};{pg};{pb}m━━┓\\e[0m\\n" "$(uname -r)"
    if command -v fastfetch >/dev/null 2>&1 && [ "$(tput cols 2>/dev/null || echo 80)" -ge 72 ]; then
        fastfetch
    fi
fi
"""
    open(os.path.join(CFG_DIR, "cyber-shell.sh"), "w", encoding="utf-8").write(shell_sh)

    # 4. Обновляем логотип и RGB-конфиг Fastfetch
    logo_txt = f"""$1      ╭────────── $2{sym}$1 ──────────╮
$1    ╭─╯   $2▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄$1   ╰─╮
$2   ╱    $1╭─╯$3  {sym} {short:<9}$1╰─╮$2    ╲
$2  │     $1│  $2╭───────────╮  $1│$2     │
$2  │     $1│  $2│ $3  ╔═══╗  $2 │  $1│$2     │
$1  {sym}─────┼──$2┤ $3  ║ {sym} ║  $2 ├──$1┼─────{sym}
$2  │     $1│  $2│ $3  ╚═══╝  $2 │  $1│$2     │
$2  │     $1│  $2╰───────────╯  $1│$2     │
$2   ╲    $1╰─╮$3  HUD // V2  $1╭─╯$2    ╱
$1    ╰─╮   $2▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀$1   ╭─╯
$1      ╰────────── $2{sym}$1 ──────────╯
"""
    os.makedirs(os.path.join(HOME, ".config/fastfetch"), exist_ok=True)
    open(os.path.join(HOME, ".config/fastfetch/cyber_logo.txt"), "w", encoding="utf-8").write(logo_txt)

    ff_cfg = f"""{{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {{
    "type": "file",
    "source": "~/.config/fastfetch/cyber_logo.txt",
    "color": {{
      "1": "38;2;{ar};{ag};{ab}",
      "2": "38;2;{pr};{pg};{pb}",
      "3": "38;2;240;244;255"
    }},
    "padding": {{ "top": 1, "left": 2, "right": 3 }}
  }},
  "display": {{
    "separator": "  ⟫  ",
    "color": {{
      "keys": "38;2;{ar};{ag};{ab}",
      "title": "38;2;240;244;255"
    }}
  }},
  "modules": [
    {{
      "type": "custom",
      "format": "\\u001b[38;2;{pr};{pg};{pb}m╭──────────── \\u001b[38;2;{ar};{ag};{ab}m{sym} CYBERDECK // {short}\\u001b[38;2;{pr};{pg};{pb}m ────────────╮\\u001b[0m"
    }},
    {{
      "type": "command",
      "key": "{sym} OPERATOR",
      "text": "printf 'CYBER-NODE // %s@%s' \\"$USER\\" \\"$(uname -n)\\""
    }},
    {{ "type": "os",       "key": "{sym} SYSTEM  " }},
    {{ "type": "kernel",   "key": "{sym} KERNEL  " }},
    {{ "type": "wm",       "key": "{sym} ENGINE  " }},
    {{ "type": "terminal", "key": "{sym} CONSOLE " }},
    {{ "type": "cpu",      "key": "{sym} CPU     " }},
    {{ "type": "gpu",      "key": "{sym} GPU     " }},
    {{ "type": "memory",   "key": "{sym} MEMORY  " }},
    {{ "type": "battery",  "key": "{sym} POWER   " }},
    {{ "type": "cursor",   "key": "{sym} CURSOR  " }},
    {{ "type": "icons",    "key": "{sym} ICONS   " }},
    {{
      "type": "custom",
      "format": "\\u001b[38;2;{pr};{pg};{pb}m╰────────────────────────────────────────────────╯\\u001b[0m"
    }},
    {{ "type": "colors", "symbol": "circle", "paddingLeft": 2 }}
  ]
}}
"""
    open(os.path.join(HOME, ".config/fastfetch/config.jsonc"), "w", encoding="utf-8").write(ff_cfg)

    # 5. Обновляем тему Btop
    btop_t = f"""theme[main_bg]="{bg_hex}"
theme[main_fg]="{fg_hex}"
theme[title]="#ffffff"
theme[hi_fg]="{a_hex}"
theme[selected_bg]="{bg_alt}"
theme[selected_fg]="#ffffff"
theme[inactive_fg]="#5c6b8a"
theme[graph_text]="{s_hex}"
theme[meter_bg]="{bg_alt}"
theme[proc_misc]="{a_hex}"
theme[cpu_box]="{p_hex}"
theme[mem_box]="{p_hex}"
theme[net_box]="{p_hex}"
theme[proc_box]="{p_hex}"
theme[div_line]="{p_hex}"
theme[cpu_start]="{a_hex}"
theme[cpu_mid]="{p_hex}"
theme[cpu_end]="{s_hex}"
"""
    os.makedirs(os.path.join(HOME, ".config/btop/themes"), exist_ok=True)
    open(os.path.join(HOME, ".config/btop/themes/cyber-deck.theme"), "w", encoding="utf-8").write(btop_t)

    # 6. ЖИВАЯ ИНЪЕКЦИЯ OSC-ЦВЕТОВ ВО ВСЕ ОТКРЫТЫЕ ОКНА ТЕРМИНАЛА (мгновенная смена фона, курсора и ANSI без перезапуска!)
    osc_seq = (
        f"\033]11;{bg_hex}\007"
        f"\033]10;{fg_hex}\007"
        f"\033]12;{a_hex}\007"
        f"\033]4;0;{bg_hex}\007"
        f"\033]4;4;{p_hex}\007"
        f"\033]4;5;{s_hex}\007"
        f"\033]4;6;{a_hex}\007"
        f"\033]4;12;{p_hex}\007"
        f"\033]4;13;{s_hex}\007"
        f"\033]4;14;{a_hex}\007"
    )
    uid = os.getuid()
    for pts in glob.glob("/dev/pts/[0-9]*"):
        try:
            if os.stat(pts).st_uid == uid:
                with open(pts, "wb", buffering=0) as f:
                    f.write(osc_seq.encode("ascii"))
        except Exception:
            pass

def apply_backend(theme_id):
    if theme_id not in THEMES:
        theme_id = "cyber-deck"
    t = THEMES[theme_id]
    p_hex, a_hex, s_hex, bg_hex = t["primary"], t["accent"], t["soft"], t["bg"]
    rad = int(t["radius"])

    # 1. Сохраняем состояние и генерируем полный CSS рабочего стола
    json.dump({"id": theme_id, **t}, open(STATE_FILE, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
    open(os.path.join(CFG_DIR, "active_hub.css"), "w", encoding="utf-8").write(build_full_theme_css(t))

    # 2. Обновляем иконки UI, пакет иконок приложений и Firefox
    for svg_f in glob.glob(os.path.join(HOME, ".config/hypr/assets/ui/*.svg")):
        stxt = open(svg_f, "r", encoding="utf-8").read()
        stxt = re.sub(r"#[0-9a-fA-F]{6}", lambda m: (
            p_hex if m.group(0).lower() in ("#4c6ef5","#e03131","#0ca678","#d63384","#f03e98","#1c7ed6","#339af0","#364fc7") else
            (a_hex if m.group(0).lower() in ("#22b8cf","#fcc419","#38d9a9","#40f99b","#20c997","#00f5d4","#74c0fc","#99e9f2","#66d9e8") else m.group(0))
        ), stxt)
        open(svg_f, "w", encoding="utf-8").write(stxt)

    for script_p in (os.path.join(HOME, ".local/bin/cyber-icons-sync"), os.path.join(HOME, ".local/bin/cyber-firefox-sync")):
        if os.path.isfile(script_p):
            txt = open(script_p, "r", encoding="utf-8").read()
            txt = re.sub(r"#[0-9a-fA-F]{6}", lambda m: (
                p_hex if m.group(0).lower() in ("#4c6ef5","#e03131","#0ca678","#d63384","#f03e98","#1c7ed6","#339af0","#364fc7") else
                (a_hex if m.group(0).lower() in ("#22b8cf","#fcc419","#38d9a9","#40f99b","#20c997","#00f5d4","#74c0fc","#99e9f2") else m.group(0))
            ), txt)
            open(script_p, "w", encoding="utf-8").write(txt)

    subprocess.run([os.path.join(HOME, ".local/bin/cyber-icons-sync")], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run([os.path.join(HOME, ".local/bin/cyber-firefox-sync")], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 3. Генерируем фоны, терминал (включая живые открытые окна!) и новый курсор со сбросом кэша
    render_cyberdeck_variant_bg(t)
    update_all_terminals_live(t)
    cur_name = rebuild_cursor_and_flush_cache(theme_id, t)

    # 4. Обновляем Mako, Rofi и GTK3/4 проводник
    mako_cfg = f"""font=Noto Sans Bold 11
markup=1
icons=1
background-color={bg_hex}f5
text-color={t['fg']}
border-color={p_hex}
border-size=2
border-radius={rad}
padding=12,16
margin=18
width=340
height=110
max-icon-size=32
icon-path={HOME}/.config/hypr/assets/ui:{HOME}/.local/share/icons/CyberDeck-Icons
default-timeout=2500
ignore-timeout=1
layer=overlay
anchor=top-right

[urgency=high]
border-color=#ff6b6b
default-timeout=4000

[app-name=cyber-kb]
background-color={bg_hex}fa
border-color={a_hex}
default-timeout=1250
width=275
padding=10,14
"""
    open(os.path.join(HOME, ".config/mako/config"), "w", encoding="utf-8").write(mako_cfg)

    for rasi_p in (os.path.join(HOME, ".config/hypr/gaming_launcher.rasi"), os.path.join(HOME, ".config/hypr/cyber_wifi.rasi")):
        if os.path.isfile(rasi_p):
            rtxt = open(rasi_p, "r", encoding="utf-8").read()
            rtxt = re.sub(r"cyan:\s*#[0-9a-fA-F]{6};", f"cyan:        {a_hex};", rtxt)
            rtxt = re.sub(r"indigo:\s*#[0-9a-fA-F]{6};", f"indigo:      {p_hex};", rtxt)
            rtxt = re.sub(r"bg:\s*#[0-9a-fA-F]{6};", f"bg:          {bg_hex};", rtxt)
            open(rasi_p, "w", encoding="utf-8").write(rtxt)

    # 5. Обновляем Hyprland (рамки окон, скругление и переменную курсора)
    p_c, a_c = p_hex.lstrip("#"), a_hex.lstrip("#")
    h_round = int(t["hypr_round"])
    for hconf in glob.glob(os.path.join(HOME, ".config/hypr/*.conf")):
        htxt = open(hconf, "r", encoding="utf-8").read()
        htxt = re.sub(r"col\.active_border\s*=\s*.*", f"col.active_border = rgba({p_c}ff) rgba({a_c}ff) 45deg", htxt)
        htxt = re.sub(r"rounding\s*=\s*\d+", f"rounding = {h_round}", htxt)
        htxt = re.sub(r"env\s*=\s*XCURSOR_THEME,.*", f"env = XCURSOR_THEME,{cur_name}", htxt)
        htxt = re.sub(r"exec-once\s*=\s*hyprctl setcursor .*", f"exec-once = hyprctl setcursor {cur_name} 28", htxt)
        open(hconf, "w", encoding="utf-8").write(htxt)

    subprocess.run([
        "hyprctl", "--batch",
        f"keyword general:col.active_border rgba({p_c}ff) rgba({a_c}ff) 45deg ; keyword decoration:rounding {h_round} ; setcursor {cur_name} 28"
    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 6. Синхронизируем SDDM и GRUB
    subprocess.run(["sudo", "-n", "/usr/local/bin/cyber-theme-sys-sync", HOME, p_hex, a_hex, cur_name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["makoctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 7. Бесшовный перезапуск фонового рабочего стола позади бронестворок
    is_game = ("game" in os.environ.get("HYPRLAND_CONFIG", "").lower()) or (subprocess.call(["pgrep", "-f", "game-hub-desktop.py"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0)
    target_py = "game-hub-desktop.py" if is_game else "work-hub-desktop.py"
    target_ns = "gaming-hub-wallpaper" if is_game else "work-hub-wallpaper"

    for old_proc in ("work-hub-desktop.py", "game-hub-desktop.py", "cyberdeck-hub-desktop.py"):
        subprocess.run(["pkill", "-9", "-f", old_proc], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    for _ in range(30):
        if subprocess.call(["pgrep", "-f", "hub-desktop.py"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
            break
        time.sleep(0.04)

    env = os.environ.copy()
    if os.path.isfile("/usr/lib/libgtk4-layer-shell.so"):
        env["LD_PRELOAD"] = "/usr/lib/libgtk4-layer-shell.so"
    subprocess.Popen(["python3", os.path.join(HOME, ".local/bin", target_py)], env=env, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    for _ in range(40):
        try:
            if target_ns in subprocess.check_output(["hyprctl", "layers", "-j"], text=True, stderr=subprocess.DEVNULL):
                break
        except Exception:
            pass
        time.sleep(0.05)

def show_menu():
    cur = load_current()
    lines, id_map = [], {}
    for tid, meta in THEMES.items():
        mark = "   [● АКТИВНА]" if tid == cur else ""
        row = f"{meta['title']}{mark}"
        lines.append(row)
        id_map[row] = tid

    proc = subprocess.run(
        ["rofi", "-dmenu", "-i", "-p", "◈ ВЫБОР ТЕМЫ ОКРУЖЕНИЯ", "-theme", ROFI_WIFI],
        input="\n".join(lines), text=True, capture_output=True
    )
    ch = proc.stdout.strip()
    if proc.returncode == 0 and ch in id_map:
        new_id = id_map[ch]
        subprocess.Popen(["python3", os.path.join(HOME, ".local/bin/cyber-theme-anim.py"), cur, new_id], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if __name__ == "__main__":
    act = sys.argv[1] if len(sys.argv) > 1 else "menu"
    if act == "--apply-backend" and len(sys.argv) > 2:
        apply_backend(sys.argv[2])
    elif act == "apply" and len(sys.argv) > 2:
        cur = load_current()
        subprocess.Popen(["python3", os.path.join(HOME, ".local/bin/cyber-theme-anim.py"), cur, sys.argv[2]], start_new_session=True)
    elif act == "get":
        print(THEMES[load_current()]["short"])
    else:
        show_menu()
