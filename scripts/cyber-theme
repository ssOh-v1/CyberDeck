def hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i+2], 16) / 255.0 for i in (0, 2, 4))

def hex_rgb_int(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def load_current():
    try:
        d = json.load(open(STATE_FILE, encoding="utf-8"))
        if d.get("id") in THEMES:
            return d["id"]
    except Exception:
        pass
    return "cyber-deck"

def build_full_theme_css(t):
    p, a, s, bg, bg_alt, fg = t["primary"], t["accent"], t["soft"], t["bg"], t["bg_alt"], t["fg"]
    cbg, dbg = t["card_bg"], t["deck_bg"]
    r = int(t["radius"])
    r_sm = max(3, r - 3)
    arch = t["arch"]

    # Каждая тема сохраняет фамильную структуру CyberDeck, но имеет собственный акцентный почерк рамок
    if arch == "ronin":
        deck_border = f"border: 1px solid {p}; border-bottom: 2px solid {a};"
        card_border = f"border: 1px solid {p}; border-left: 3px solid {a};"
    elif arch == "matrix":
        deck_border = f"border: 1px solid {a};"
        card_border = f"border: 1px solid {p}; border-top: 2px solid {a};"
    elif arch == "synth":
        deck_border = f"border: 1px solid {p}; border-top: 2px solid {a};"
        card_border = f"border: 1px solid {p}; border-bottom: 2px solid {a};"
    elif arch == "cryo":
        deck_border = f"border: 1px solid {a};"
        card_border = f"border: 1px solid {p};"
    else:
        deck_border = f"border: 1px solid #243252;"
        card_border = f"border: 1px solid #202a42;"

    return f"""
