#!/usr/bin/env python3
import os, sys, re, glob, json, math, shutil, tempfile, subprocess, cairo

os.environ.pop("LD_PRELOAD", None)
HOME = os.path.expanduser("~")
CFG_DIR = os.path.join(HOME, ".config/cyberdeck")
CACHE_DIR = os.path.join(HOME, ".cache/cyberdeck")
STATE_FILE = os.path.join(CFG_DIR, "theme.json")
ROFI_WIFI = os.path.join(HOME, ".config/hypr/cyber_wifi.rasi")
os.makedirs(CFG_DIR, exist_ok=True)
os.makedirs(CACHE_DIR, exist_ok=True)

THEMES = {
    "cyber-cyan": {
        "title": "◈ Cyber Cyan // Тактический Индиго и Бирюза [Дефолт]",
        "short": "Cyan",
        "primary": "#4c6ef5",
        "accent":  "#22b8cf",
        "soft":    "#66d9e8",
        "bg":      "#07090f",
    },
    "crimson-matrix": {
        "title": "◈ Crimson Matrix // Красный Неон (Arasaka HUD)",
        "short": "Crimson",
        "primary": "#e03131",
        "accent":  "#ff6b6b",
        "soft":    "#ffa8a8",
        "bg":      "#0b0709",
    },
    "emerald-netrunner": {
        "title": "◈ Emerald Netrunner // Матричный Изумруд",
        "short": "Emerald",
        "primary": "#0ca678",
        "accent":  "#20c997",
        "soft":    "#63e6be",
        "bg":      "#060b09",
    },
    "amber-deus": {
        "title": "◈ Amber Gold // Кибер-Янтарь и Золото",
        "short": "Amber",
        "primary": "#f08c00",
        "accent":  "#fcc419",
        "soft":    "#ffe066",
        "bg":      "#0b0906",
    },
    "violet-phantom": {
        "title": "◈ Violet Phantom // Квантовый Фиолетовый",
        "short": "Violet",
        "primary": "#7950f2",
        "accent":  "#b197fc",
        "soft":    "#d0bfff",
        "bg":      "#08060e",
    },
}

def hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i+2], 16) / 255.0 for i in (0, 2, 4))

def load_current():
    try:
        data = json.load(open(STATE_FILE, encoding="utf-8"))
        if data.get("id") in THEMES:
            return data["id"]
    except Exception:
        pass
    return "cyber-cyan"

def rebuild_cursor(prim_hex, acc_hex):
    theme_dir = os.path.join(HOME, ".local/share/icons/CyberDeck-Cursor")
    cursors_dir = os.path.join(theme_dir, "cursors")
    shutil.rmtree(theme_dir, ignore_errors=True)
    os.makedirs(cursors_dir, exist_ok=True)
    open(os.path.join(theme_dir, "index.theme"), "w", encoding="utf-8").write(
        "[Icon Theme]\nName=CyberDeck-Cursor\nComment=CyberDeck Adaptive Cursor\nInherits=Adwaita\n"
    )

    INDIGO = hex_rgb(prim_hex)
    CYAN   = hex_rgb(acc_hex)
    DARK   = (0.039, 0.055, 0.098)
    LIGHT  = (0.92, 0.95, 1.0)
    RED    = (1.0, 0.42, 0.42)

    def new_surf(sz):
        s = cairo.ImageSurface(cairo.FORMAT_ARGB32, sz, sz)
        cr = cairo.Context(s); cr.scale(sz / 32.0, sz / 32.0)
        cr.set_line_cap(cairo.LINE_CAP_ROUND); cr.set_line_join(cairo.LINE_JOIN_ROUND)
        return s, cr

    def draw_arrow(cr):
        pts = [(3,2),(3,24),(8.8,19.2),(12.6,27.5),(16.0,25.8),(12.2,17.6),(19.8,17.6)]
        cr.move_to(*pts[0])
        for p in pts[1:]: cr.line_to(*p)
        cr.close_path(); cr.set_source_rgba(*DARK, 0.96); cr.fill_preserve()
        lg = cairo.LinearGradient(3,2,19,27)
        lg.add_color_stop_rgb(0.0, *CYAN); lg.add_color_stop_rgb(0.65, *INDIGO); lg.add_color_stop_rgb(1.0, *CYAN)
        cr.set_source(lg); cr.set_line_width(1.8); cr.stroke()
        cr.arc(4.3, 4.6, 1.2, 0, 2*math.pi); cr.set_source_rgb(*CYAN); cr.fill()

    def draw_pointer(cr):
        pts = [(6,5),(6,23),(11.2,18.8),(15.5,26),(18.5,24.4),(14.2,17.2),(21,17.2)]
        cr.move_to(*pts[0])
        for p in pts[1:]: cr.line_to(*p)
        cr.close_path(); cr.set_source_rgba(*DARK, 0.96); cr.fill_preserve()
        cr.set_source_rgb(*CYAN); cr.set_line_width(1.8); cr.stroke()
        cx, cy, r = 6.0, 5.0, 3.6
        cr.move_to(cx, cy-r); cr.line_to(cx+r, cy); cr.line_to(cx, cy+r); cr.line_to(cx-r, cy); cr.close_path()
        cr.set_source_rgba(*DARK, 0.95); cr.fill_preserve(); cr.set_source_rgb(*LIGHT); cr.set_line_width(1.4); cr.stroke()

    def draw_ibeam(cr):
        for w, col, al in [(4.2,(0,0,0),0.65), (1.9,CYAN,1.0)]:
            cr.set_line_width(w); cr.set_source_rgba(*col, al)
            cr.move_to(16,5); cr.line_to(16,27); cr.move_to(11.5,5); cr.line_to(20.5,5); cr.move_to(11.5,27); cr.line_to(20.5,27); cr.stroke()

    def draw_cross(cr):
        cr.set_line_width(1.8); cr.set_source_rgb(*CYAN)
        for x1,y1,x2,y2 in [(16,3,16,11),(16,21,16,29),(3,16,11,16),(21,16,29,16)]: cr.move_to(x1,y1); cr.line_to(x2,y2)
        cr.stroke()
        cr.set_line_width(1.3); cr.set_source_rgba(*INDIGO, 0.9); cr.arc(16,16,6.5,0,2*math.pi); cr.stroke()

    def draw_darrow(cr, ang):
        cr.save(); cr.translate(16,16); cr.rotate(math.radians(ang))
        for lw, col, al in [(4.2,(0,0,0),0.6), (2.0,CYAN,1.0)]:
            cr.set_line_width(lw); cr.set_source_rgba(*col, al)
            cr.move_to(-10,0); cr.line_to(10,0); cr.move_to(-6,-4.5); cr.line_to(-11,0); cr.line_to(-6,4.5); cr.move_to(6,-4.5); cr.line_to(11,0); cr.line_to(6,4.5); cr.stroke()
        cr.restore()

    def draw_grab(cr, closed=False):
        r = 7.5 if closed else 9.5
        cr.arc(16,16,r,0,2*math.pi); cr.set_source_rgba(*DARK,0.95); cr.fill_preserve()
        cr.set_line_width(2.0); cr.set_source_rgb(*(CYAN if closed else INDIGO)); cr.stroke()

    def draw_deny(cr):
        cr.arc(16,16,10.5,0,2*math.pi); cr.set_source_rgba(*DARK,0.92); cr.fill_preserve()
        cr.set_line_width(2.4); cr.set_source_rgb(*RED); cr.stroke()
        cr.move_to(9.2,9.2); cr.line_to(22.8,22.8); cr.stroke()

    def draw_spin(cr, ph, mini=False):
        cx, cy, r = (22.5, 21.5, 6.2) if mini else (16.0, 16.0, 10.5)
        cr.arc(cx,cy,r,0,2*math.pi); cr.set_source_rgba(*DARK,0.85); cr.fill_preserve()
        cr.set_line_width(2.0); cr.set_source_rgba(*INDIGO,0.35); cr.stroke()
        a0 = ph * 2 * math.pi
        cr.set_line_width(2.4); cr.set_source_rgb(*CYAN); cr.arc(cx,cy,r,a0,a0+math.pi*0.9); cr.stroke()
        cr.set_source_rgb(*INDIGO); cr.arc(cx,cy,r,a0+math.pi,a0+math.pi*1.55); cr.stroke()

    tmp = tempfile.mkdtemp(prefix="cd_cur_")
    try:
        sizes = [24, 32, 48]
        def b_static(name, hx32, hy32, fn):
            lines = []
            for sz in sizes:
                s, cr = new_surf(sz); fn(cr)
                png = os.path.join(tmp, f"{name}_{sz}.png"); s.write_to_png(png)
                lines.append(f"{sz} {int(round(hx32*sz/32.0))} {int(round(hy32*sz/32.0))} {png}")
            cfg = os.path.join(tmp, f"{name}.cfg"); open(cfg,"w").write("\n".join(lines)+"\n")
            subprocess.run(["xcursorgen", cfg, os.path.join(cursors_dir, name)], check=True)
        def b_anim(name, hx32, hy32, mini=False):
            lines = []
            for sz in sizes:
                for fr in range(12):
                    s, cr = new_surf(sz)
                    if mini: draw_arrow(cr)
                    draw_spin(cr, fr/12.0, mini)
                    png = os.path.join(tmp, f"{name}_{sz}_{fr}.png"); s.write_to_png(png)
                    lines.append(f"{sz} {int(round(hx32*sz/32.0))} {int(round(hy32*sz/32.0))} {png} 55")
            cfg = os.path.join(tmp, f"{name}.cfg"); open(cfg,"w").write("\n".join(lines)+"\n")
            subprocess.run(["xcursorgen", cfg, os.path.join(cursors_dir, name)], check=True)

        b_static("left_ptr", 3, 2, draw_arrow)
        b_static("hand2", 6, 5, draw_pointer)
        b_static("xterm", 16, 16, draw_ibeam)
        b_static("crosshair", 16, 16, draw_cross)
        b_static("fleur", 16, 16, lambda cr: (draw_darrow(cr,0), draw_darrow(cr,90)))
        b_static("sb_h_double_arrow", 16, 16, lambda cr: draw_darrow(cr,0))
        b_static("sb_v_double_arrow", 16, 16, lambda cr: draw_darrow(cr,90))
        b_static("bd_double_arrow", 16, 16, lambda cr: draw_darrow(cr,45))
        b_static("fd_double_arrow", 16, 16, lambda cr: draw_darrow(cr,-45))
        b_static("grab", 16, 16, lambda cr: draw_grab(cr,False))
        b_static("grabbing", 16, 16, lambda cr: draw_grab(cr,True))
        b_static("not_allowed", 16, 16, draw_deny)
        b_anim("watch", 16, 16, False)
        b_anim("left_ptr_watch", 3, 2, True)

        aliases = {
            "left_ptr": ["default","arrow","top_left_arrow","right_ptr","help","context-menu","copy"],
            "hand2": ["pointer","hand1","pointing_hand"],
            "xterm": ["text","ibeam"],
            "crosshair": ["cross","tcross","plus","color-picker"],
            "fleur": ["move","size_all","all-scroll"],
            "sb_h_double_arrow": ["ew-resize","col-resize","size_hor","left_side","right_side","e-resize","w-resize"],
            "sb_v_double_arrow": ["ns-resize","row-resize","size_ver","top_side","bottom_side","n-resize","s-resize"],
            "bd_double_arrow": ["nwse-resize","size_fdiag","top_left_corner","bottom_right_corner","nw-resize","se-resize"],
            "fd_double_arrow": ["nesw-resize","size_bdiag","top_right_corner","bottom_left_corner","ne-resize","sw-resize"],
            "grab": ["openhand"],
            "grabbing": ["closedhand","dnd-move","dnd-copy"],
            "not_allowed": ["not-allowed","crossed_circle","no-drop","forbidden"],
            "watch": ["wait"],
            "left_ptr_watch": ["progress","half-busy"],
        }
        for tgt, lks in aliases.items():
            for lk in lks:
                lp = os.path.join(cursors_dir, lk)
                if not os.path.exists(lp): os.symlink(tgt, lp)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

def render_backgrounds(prim_hex, acc_hex, bg_hex):
    PRIM, ACC, BG = hex_rgb(prim_hex), hex_rgb(acc_hex), hex_rgb(bg_hex)
    W, H = 1920, 1080
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, W, H)
    cr = cairo.Context(surf)
    cr.set_source_rgb(*BG); cr.paint()

    for cx, cy, rad, col, al in [(W * 0.15, H * 0.12, 620, PRIM, 0.11), (W * 0.85, H * 0.86, 640, ACC, 0.09)]:
        rg = cairo.RadialGradient(cx, cy, 10, cx, cy, rad)
        rg.add_color_stop_rgba(0.0, *col, al); rg.add_color_stop_rgba(1.0, *col, 0.0)
        cr.set_source(rg); cr.paint()

    cr.set_line_width(1.0); cr.set_source_rgba(*PRIM, 0.06)
    for x in range(96, W, 96): cr.move_to(x, 0); cr.line_to(x, H)
    for y in range(96, H, 96): cr.move_to(0, y); cr.line_to(W, y)
    cr.stroke()

    m, ln = 14, 52
    cr.set_line_width(2.2); cr.set_source_rgba(*ACC, 0.72)
    for x1, y1, x2, y2, x3, y3 in [
        (m, m + ln, m, m, m + ln, m), (W - m - ln, m, W - m, m, W - m, m + ln),
        (m, H - m - ln, m, H - m, m + ln, H - m), (W - m - ln, H - m, W - m, H - m, W - m, H - m - ln),
    ]:
        cr.move_to(x1, y1); cr.line_to(x2, y2); cr.line_to(x3, y3)
    cr.stroke()

    for nm in ("work_hud_bg.png", "gaming_hud_bg.png", "cyberdeck_hud_bg.png", "sddm_bg.png"):
        surf.write_to_png(os.path.join(CACHE_DIR, nm))

def recolor_file(path, old_p, old_a, new_p, new_a):
    if not os.path.isfile(path):
        return
    txt = open(path, "r", encoding="utf-8", errors="ignore").read()
    # Меняем базовые индиго/циан или предыдущие цвета на новые
    for op in ("#4c6ef5", "#364fc7", "#3b5bdb", old_p):
        if op: txt = re.sub(re.escape(op), new_p, txt, flags=re.I)
    for oa in ("#22b8cf", "#66d9e8", old_a):
        if oa: txt = re.sub(re.escape(oa), new_a, txt, flags=re.I)
    open(path, "w", encoding="utf-8").write(txt)

def apply_theme(theme_id):
    if theme_id not in THEMES:
        theme_id = "cyber-cyan"
    old_id = load_current()
    old_t = THEMES.get(old_id, THEMES["cyber-cyan"])
    new_t = THEMES[theme_id]

    p_hex, a_hex, bg_hex = new_t["primary"], new_t["accent"], new_t["bg"]
    json.dump({"id": theme_id, **new_t}, open(STATE_FILE, "w", encoding="utf-8"), indent=2, ensure_ascii=False)

    # 1. Перекрашиваем иконки, Rofi, Mako, GTK, Firefox и Терминалы
    for fpath in [
        os.path.join(HOME, ".local/bin/cyber-icons-sync"),
        os.path.join(HOME, ".local/bin/cyber-firefox-sync"),
        os.path.join(HOME, ".config/hypr/gaming_launcher.rasi"),
        os.path.join(HOME, ".config/hypr/cyber_wifi.rasi"),
        os.path.join(HOME, ".config/mako/config"),
        os.path.join(HOME, ".config/gtk-3.0/gtk.css"),
        os.path.join(HOME, ".config/gtk-4.0/gtk.css"),
        os.path.join(HOME, ".config/kitty/cyber-deck.conf"),
    ] + glob.glob(os.path.join(HOME, ".config/hypr/assets/ui/*.svg")):
        recolor_file(fpath, old_t["primary"], old_t["accent"], p_hex, a_hex)

    # Foot ini использует цвета без #
    foot_p = os.path.join(HOME, ".config/foot/foot.ini")
    if os.path.isfile(foot_p):
        ftxt = open(foot_p, "r", encoding="utf-8").read()
        ftxt = re.sub(r"cursor=07090f [0-9a-fA-F]{6}", f"cursor=07090f {a_hex.lstrip('#')}", ftxt)
        ftxt = re.sub(r"regular4=[0-9a-fA-F]{6}", f"regular4={p_hex.lstrip('#')}", ftxt)
        ftxt = re.sub(r"regular6=[0-9a-fA-F]{6}", f"regular6={a_hex.lstrip('#')}", ftxt)
        open(foot_p, "w", encoding="utf-8").write(ftxt)

    # 2. Пересобираем иконки, Firefox, курсор и фоны
    subprocess.run([os.path.join(HOME, ".local/bin/cyber-icons-sync")], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run([os.path.join(HOME, ".local/bin/cyber-firefox-sync")], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    rebuild_cursor(p_hex, a_hex)
    render_backgrounds(p_hex, a_hex, bg_hex)

    # 3. Обновляем рамки окон Hyprland и перезагружаем курсор на лету
    p_clean, a_clean = p_hex.lstrip("#"), a_hex.lstrip("#")
    for hconf in glob.glob(os.path.join(HOME, ".config/hypr/*.conf")):
        htxt = open(hconf, "r", encoding="utf-8").read()
        htxt = re.sub(r"col\.active_border\s*=\s*.*", f"col.active_border = rgba({p_clean}ff) rgba({a_clean}ff) 45deg", htxt)
        open(hconf, "w", encoding="utf-8").write(htxt)

    subprocess.run(["hyprctl", "--batch", f"keyword general:col.active_border rgba({p_clean}ff) rgba({a_clean}ff) 45deg ; setcursor CyberDeck-Cursor 28"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", "Default"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", "CyberDeck-Cursor"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 4. Синхронизируем SDDM и GRUB через sudo-хелпер
    subprocess.run(["sudo", "-n", "/usr/local/bin/cyber-theme-sys-sync", HOME, p_hex, a_hex], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 5. Перезапускаем Mako и активный рабочий стол для мгновенного применения
    subprocess.run(["makoctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for hub_scr, hub_cmd in [("work-hub-desktop.py", "work-hub"), ("game-hub-desktop.py", "game-hub"), ("cyberdeck-hub-desktop.py", "cyberdeck-hub")]:
        if subprocess.call(["pgrep", "-f", hub_scr], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0:
            subprocess.run(["pkill", "-9", "-f", hub_scr], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.Popen([os.path.join(HOME, ".local/bin", hub_cmd)], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    subprocess.Popen([
        "notify-send", "-a", "cyber-kb",
        f"◈ ТЕМА ПРИМЕНЕНА // {new_t['short'].upper()}",
        "Синхронизированы: Рабочий стол, Курсор, Иконки, Терминал, Firefox, SDDM и GRUB (для Firefox перезапустите браузер)"
    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def show_menu():
    cur = load_current()
    lines = []
    id_map = {}
    for tid, meta in THEMES.items():
        mark = "   [● АКТИВНА]" if tid == cur else ""
        row = f"{meta['title']}{mark}"
        lines.append(row)
        id_map[row] = tid

    proc = subprocess.run(
        ["rofi", "-dmenu", "-i", "-p", "◈ ТЕМА ОКРУЖЕНИЯ", "-theme", ROFI_WIFI],
        input="\n".join(lines), text=True, capture_output=True
    )
    ch = proc.stdout.strip()
    if proc.returncode == 0 and ch in id_map:
        apply_theme(id_map[ch])

if __name__ == "__main__":
    act = sys.argv[1] if len(sys.argv) > 1 else "menu"
    if act == "get":
        cur = load_current()
        print(THEMES[cur]["short"])
    elif act == "apply" and len(sys.argv) > 2:
        apply_theme(sys.argv[2])
    else:
        show_menu()
