def hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i+2], 16) / 255.0 for i in (0, 2, 4))

def hex_rgb_int(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def is_gaming_session():
    if "game" in os.environ.get("HYPRLAND_CONFIG", "").lower():
        return True
    return subprocess.call(["pgrep", "-f", "game-hub-desktop.py"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0

def load_current():
    sfile = GAME_STATE if is_gaming_session() else WORK_STATE
    for f in (sfile, STATE_FILE):
        if os.path.isfile(f):
            try:
                tid = json.load(open(f, encoding="utf-8")).get("id", "")
                if tid in THEMES:
                    return tid
            except Exception:
                pass
    return "cyberdeck"

