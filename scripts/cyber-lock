#!/bin/bash
unset LD_PRELOAD
if pgrep -x hyprlock >/dev/null 2>&1; then
    exit 0
fi

# 1. Запускаем анимацию закрытия створок (она сама стартует hyprlock в пиковой фазе)
LD_PRELOAD="/usr/lib/libgtk4-layer-shell.so" /usr/bin/python3 "$HOME/.local/bin/cyber-lock-anim.py" lock

# 2. Ждём завершения сессии hyprlock (пока пользователь не введёт пароль)
for _ in $(seq 1 20); do
    pgrep -x hyprlock >/dev/null 2>&1 && break
    sleep 0.05
done
while pgrep -x hyprlock >/dev/null 2>&1; do
    sleep 0.12
done

# 3. Запускаем анимацию раскрытия створок при входе обратно на рабочий стол
LD_PRELOAD="/usr/lib/libgtk4-layer-shell.so" /usr/bin/python3 "$HOME/.local/bin/cyber-lock-anim.py" unlock &
