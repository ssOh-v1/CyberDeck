#!/bin/bash
unset LD_PRELOAD

if [ "$1" = "--wipe" ]; then
    cliphist wipe 2>/dev/null || true
    wl-copy --clear 2>/dev/null || true
    rm -rf "/tmp/studio_clip_thumbs_${UID}"
    notify-send -a cyber-kb "󰅌 БУФЕР ОБМЕНА" "История буфера полностью очищена"
    exit 0
fi

# Если окно буфера уже открыто — закрываем его (удобный toggle по SUPER+V)
if pgrep -f "cyber-clipboard\.py" >/dev/null 2>&1; then
    pkill -TERM -f "cyber-clipboard\.py" 2>/dev/null || true
    rm -f "/tmp/studio_clipboard_${UID}.pid"
    exit 0
fi

LD_PRELOAD="/usr/lib/libgtk4-layer-shell.so" nohup /usr/bin/python3 "$HOME/.local/bin/cyber-clipboard.py" >/tmp/cyber-clipboard.err 2>&1 &
