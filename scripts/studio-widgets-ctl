DEFAULTS = {
    "ai":       {"title": "▣ AI STUDIO",  "x": 18,   "y": 46,  "w": 335, "h": 300, "min_w": 240, "min_h": 180, "collapsed": False},
    "notes":    {"title": "▣ ЗАМЕТКИ",    "x": 18,   "y": 358, "w": 335, "h": 210, "min_w": 210, "min_h": 130, "collapsed": False},
    "calendar": {"title": "▣ КАЛЕНДАРЬ",  "x": 1622, "y": 46,  "w": 280, "h": 210, "min_w": 220, "min_h": 160, "collapsed": False},
    "media":    {"title": "▣ МЕДИАПЛЕЕР", "x": 1622, "y": 268, "w": 280, "h": 130, "min_w": 230, "min_h": 110, "collapsed": False},
}

if (sys.argv[1] if len(sys.argv) > 1 else "") == "reset":
    os.makedirs(os.path.dirname(STATE_F), exist_ok=True)
