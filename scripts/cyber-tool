#!/bin/bash
unset LD_PRELOAD
case "$1" in
    btop)
        # Открываем Btop в большом центрированном окне 1480x880
        hyprctl dispatch exec "[float; size 1480 880; center] foot --app-id=floating-btop -o main.pad=14x10 -e btop" >/dev/null 2>&1
        ;;
    pick)
        HEX=$(hyprpicker -a -n 2>/dev/null)
        [ -n "$HEX" ] && notify-send -a cyber-kb "▣ ПИПЕТКА // $HEX" "Цвет скопирован в буфер обмена"
        ;;
    shot)
        mkdir -p "$HOME/Pictures/Screenshots"
        OUT="$HOME/Pictures/Screenshots/shot_$(date +%Y%m%d_%H%M%S).png"
        if grim -g "$(slurp 2>/dev/null)" "$OUT" 2>/dev/null; then
            wl-copy < "$OUT" 2>/dev/null || true
            notify-send -a cyber-kb "▣ СКРИНШОТ СОХРАНЁН" "Скопирован в буфер и папку Screenshots"
        fi
        ;;
esac
