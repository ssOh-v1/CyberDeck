#!/usr/bin/env python3
import os, glob, json, time, signal, socket, select, subprocess

os.environ.pop("LD_PRELOAD", None)
UID = os.getuid()
HOME = os.path.expanduser("~")
PID_FILE = f"/tmp/cyber_kb_osd_{UID}.pid"
STATE_FILE = f"/tmp/alpora_kb_layout_{UID}"
ICON_PATH = os.path.join(HOME, ".config/hypr/assets/ui/kb.svg")

# Безопасная замена старого экземпляра по точному PID без pkill -f
if os.path.isfile(PID_FILE):
    try:
        old_pid = int(open(PID_FILE).read().strip())
        if old_pid != os.getpid():
            os.kill(old_pid, signal.SIGTERM)
            time.sleep(0.08)
    except Exception:
        pass
open(PID_FILE, "w").write(str(os.getpid()))

def parse_layout(layout_str):
    low = (layout_str or "").lower()
    if any(k in low for k in ("rus", "ru", "рус", "cyrillic")):
        return "RU", "Русский [RU]"
    if any(k in low for k in ("eng", "us", "en", "англ")):
        return "EN", "English [US]"
    short = (layout_str or "EN")[:2].upper()
    return short, layout_str or "EN"

def query_main_keyboard():
    try:
        devs = json.loads(subprocess.check_output(["hyprctl", "devices", "-j"], text=True, stderr=subprocess.DEVNULL))
        kbs = devs.get("keyboards", [])
        for kb in kbs:
            if kb.get("main") and "," in kb.get("layout", ""):
                return parse_layout(kb.get("active_keymap", "EN"))
        for kb in kbs:
            if kb.get("main"):
                return parse_layout(kb.get("active_keymap", "EN"))
        for kb in kbs:
            if "," in kb.get("layout", "") and "virtual" not in kb.get("name", "").lower():
                return parse_layout(kb.get("active_keymap", "EN"))
    except Exception:
        pass
    return None, None

def find_hypr_socket2():
    xdg = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{UID}")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    candidates = []
    if sig:
        candidates.append(os.path.join(xdg, "hypr", sig, ".socket2.sock"))
        candidates.append(os.path.join("/tmp/hypr", sig, ".socket2.sock"))
    for p in sorted(glob.glob(os.path.join(xdg, "hypr", "*", ".socket2.sock")), key=os.path.getmtime, reverse=True):
        candidates.append(p)
    for p in sorted(glob.glob("/tmp/hypr/*/.socket2.sock"), key=os.path.getmtime, reverse=True):
        candidates.append(p)
    for c in candidates:
        if os.path.exists(c):
            return c
    return None

def send_kb_notify(code, full):
    try:
        open(STATE_FILE, "w").write(code)
    except Exception:
        pass
    subprocess.Popen([
        "notify-send",
        "-a", "cyber-kb",
        "-i", ICON_PATH,
        "-h", "string:x-canonical-private-synchronous:kb-layout",
        f"◈ РАСКЛАДКА // {code}",
        f"Активный ввод: {full}"
    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def listen_loop():
    last_code, _ = query_main_keyboard()
    if not last_code:
        last_code = "EN"
    try:
        open(STATE_FILE, "w").write(last_code)
    except Exception:
        pass

    sock_path = find_hypr_socket2()
    if not sock_path:
        time.sleep(1.5)
        return

    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(sock_path)
        s.setblocking(False)
        buf = ""
        while True:
            r, _, _ = select.select([s], [], [], 2.0)
            if not r:
                continue
            chunk = s.recv(8192).decode("utf-8", errors="ignore")
            if not chunk:
                break
            buf += chunk
            saw_layout = False
            event_layout = None
            while "\n" in buf:
                line, buf = buf.split("\n", 1)
                if line.startswith("activelayout>>"):
                    saw_layout = True
                    parts = line.split(">>", 1)[1].split(",", 1)
                    if len(parts) == 2 and parts[1].strip():
                        dev_name = parts[0].lower()
                        if not any(x in dev_name for x in ("power", "video", "sleep", "wireless hotkeys", "wmi")):
                            event_layout = parts[1].strip()

            if saw_layout:
                # Дожидаемся окончания пакета событий от виртуальных устройств ноутбука (35 мс)
                time.sleep(0.035)
                try:
                    extra = s.recv(8192).decode("utf-8", errors="ignore")
                    if extra:
                        buf += extra
                        while "\n" in buf:
                            line, buf = buf.split("\n", 1)
                            if line.startswith("activelayout>>"):
                                parts = line.split(">>", 1)[1].split(",", 1)
                                if len(parts) == 2 and parts[1].strip():
                                    dev_name = parts[0].lower()
                                    if not any(x in dev_name for x in ("power", "video", "sleep", "wireless hotkeys", "wmi")):
                                        event_layout = parts[1].strip()
                except BlockingIOError:
                    pass

                code, full = query_main_keyboard()
                if not code and event_layout:
                    code, full = parse_layout(event_layout)
                if code and code != last_code:
                    last_code = code
                    send_kb_notify(code, full)

if __name__ == "__main__":
    while True:
        try:
            listen_loop()
        except Exception:
            time.sleep(1.5)
