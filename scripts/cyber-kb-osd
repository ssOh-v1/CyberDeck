#!/usr/bin/python3
import os, sys, json, socket, signal, subprocess

os.environ.pop("LD_PRELOAD", None)

UID = os.getuid()
HOME = os.path.expanduser("~")
PID_FILE = f"/tmp/cyber_kb_osd_{UID}.pid"
STATE_FILE = f"/tmp/alpora_kb_layout_{UID}"

try:
    if os.path.isfile(PID_FILE):
        old_pid = int(open(PID_FILE).read().strip())
        if old_pid != os.getpid():
            os.kill(old_pid, signal.SIGTERM)
except Exception:
    pass
open(PID_FILE, "w").write(str(os.getpid()))

def norm_layout(raw):
    low = raw.lower()
    if any(k in low for k in ("ru", "rus", "рус", "cyrillic")):
        return "RU", "Русская раскладка", "Кириллица • UTF-8"
    return "EN", "English layout", "Latin US • UTF-8"

def build_keycap_svg(code):
    svg_path = f"/tmp/cyber_kb_badge_{UID}.svg"
    is_ru = (code == "RU")
    dot_en = "#525761" if is_ru else "#d4d8de"
    dot_ru = "#d4d8de" if is_ru else "#525761"
    svg = f"""<svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 44 44">
  <defs>
    <linearGradient id="kc" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#282c34"/>
      <stop offset="100%" stop-color="#191b20"/>
    </linearGradient>
  </defs>
  <rect x="2" y="2" width="40" height="40" rx="9" fill="#121316" stroke="#454a52" stroke-width="1.5"/>
  <rect x="5" y="4" width="34" height="33" rx="6" fill="url(#kc)" stroke="#6c727d" stroke-width="1.2"/>
  <text x="22" y="25" text-anchor="middle" font-family="JetBrainsMono Nerd Font, Inter, monospace" font-weight="800" font-size="14.5" fill="#f0f3f8">{code}</text>
  <circle cx="18" cy="39" r="1.6" fill="{dot_en}"/>
  <circle cx="26" cy="39" r="1.6" fill="{dot_ru}"/>
</svg>"""
    open(svg_path, "w", encoding="utf-8").write(svg)
    return svg_path

def send_kb_notify(code, title_txt, sub_txt):
    open(STATE_FILE, "w").write(code)
    subprocess.Popen([os.path.join(HOME, ".local/bin/cyber-kb-sync-x11")], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    icon_p = build_keycap_svg(code)
    subprocess.Popen([
        "notify-send", "-a", "cyber-kb",
        "-h", "string:x-canonical-private-synchronous:cyber-kb",
        "-i", icon_p,
        f"▣ {title_txt}",
        f"<span foreground='#9ea4b0' size='small'>{sub_txt}</span>"
    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

try:
    devs = json.loads(subprocess.check_output(["hyprctl", "devices", "-j"], text=True, stderr=subprocess.DEVNULL))
    for k in devs.get("keyboards", []):
        if k.get("main"):
            c, _, _ = norm_layout(k.get("active_keymap", "EN"))
            open(STATE_FILE, "w").write(c)
            break
except Exception:
    open(STATE_FILE, "w").write("EN")

sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
xdg = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{UID}")
sock_candidates = [
    os.path.join(xdg, "hypr", sig, ".socket2.sock"),
    f"/tmp/hypr/{sig}/.socket2.sock",
]
sock_path = next((p for p in sock_candidates if os.path.exists(p)), None)
if not sock_path:
    sys.exit(0)

last_code = ""
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
    s.connect(sock_path)
    buf = ""
    while True:
        chunk = s.recv(4096)
        if not chunk:
            break
        buf += chunk.decode("utf-8", errors="ignore")
        while "\n" in buf:
            line, buf = buf.split("\n", 1)
            if line.startswith("activelayout>>"):
                parts = line.split(">>", 1)[1].split(",")
                if len(parts) >= 2:
                    code, title_txt, sub_txt = norm_layout(parts[1].strip())
                    if code != last_code:
                        last_code = code
                        send_kb_notify(code, title_txt, sub_txt)
