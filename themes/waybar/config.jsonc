{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 5,
  "margin-left": 14,
  "margin-right": 14,
  "margin-bottom": 0,
  "spacing": 4,
  "exclusive": true,
  "passthrough": false,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "cpu",
    "memory"
  ],
  "modules-center": [],
  "modules-right": [
    "tray",
    "backlight",
    "backlight/slider",
    "pulseaudio",
    "pulseaudio/slider",
    "custom/wifi",
    "custom/power-mode",
    "hyprland/language",
    "battery",
    "custom/clipboard",
    "custom/notifications",
    "clock",
    "custom/lock",
    "custom/poweroff"
  ],
  "custom/launcher": {
    "format": "▣",
    "on-click": "rofi -show drun -theme ~/.config/hypr/gaming_launcher.rasi",
    "on-click-right": "~/.local/bin/cyber-tool btop",
    "tooltip": false
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "all-outputs": true,
    "sort-by-number": true,
    "tooltip": false
  },
  "cpu": {
    "interval": 2,
    "format": "󰻠 CPU {usage}%",
    "on-click": "~/.local/bin/cyber-tool btop",
    "tooltip": false
  },
  "memory": {
    "interval": 3,
    "format": "󰍛 RAM {used:0.1f}G",
    "on-click": "~/.local/bin/cyber-tool btop",
    "on-click-right": "sudo -n /usr/local/bin/cyber-power-hw purge-ram && notify-send -a cyber-kb '▣ STUDIO' 'Кэш ОЗУ очищен'",
    "tooltip": false
  },
  "tray": {
    "icon-size": 15,
    "spacing": 8,
    "show-passive-items": true,
    "tooltip": false
  },
  "backlight": {
    "format": "󰃠 {percent}%",
    "on-scroll-up": "brightnessctl -q set +5%",
    "on-scroll-down": "brightnessctl -q set 5%-",
    "on-click": "sh -c 'CUR=$(brightnessctl -m | cut -d, -f4 | tr -d \"%\"); [ \"$CUR\" -lt 95 ] && brightnessctl -q set 100% || brightnessctl -q set 60%'",
    "tooltip": false
  },
  "backlight/slider": {
    "min": 5,
    "max": 100,
    "orientation": "horizontal",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "󰕾 {volume}%",
    "format-muted": "󰝟 MUTE",
    "on-click": "~/.local/bin/cyber-audio-menu",
    "on-click-right": "pamixer -t",
    "on-scroll-up": "pamixer -i 5",
    "on-scroll-down": "pamixer -d 5",
    "tooltip": false
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
    "tooltip": false
  },
  "custom/wifi": {
    "exec": "~/.local/bin/waybar-wifi",
    "return-type": "json",
    "interval": 4,
    "on-click": "~/.local/bin/cyber-wifi-menu",
    "tooltip": false
  },
  "custom/power-mode": {
    "exec": "~/.local/bin/waybar-power-mode",
    "return-type": "json",
    "interval": 2,
    "on-click": "~/.local/bin/cyber-power toggle",
    "on-click-right": "~/.local/bin/cyber-power menu",
    "tooltip": false
  },
  "hyprland/language": {
    "format": "{}",
    "format-en": "EN",
    "format-ru": "RU",
    "on-click": "hyprctl switchxkblayout all next",
    "tooltip": false
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "󰁹 {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "tooltip": false
  },
  "custom/notifications": {
    "exec": "~/.local/bin/waybar-notif-status",
    "return-type": "json",
    "interval": 2,
    "on-click": "touch /tmp/studio_toggle_notif_center",
    "on-click-right": "makoctl mode -t do-not-disturb",
    "tooltip": false
  },
  "clock": {
    "format": "{:%H:%M  •  %d.%m}",
    "tooltip": false
  },
  "custom/lock": {
    "format": "󰌾",
    "on-click": "~/.local/bin/cyber-lock",
    "tooltip": false
  },
  "custom/poweroff": {
    "format": "󰐥",
    "on-click": "systemctl poweroff",
    "on-click-right": "systemctl reboot",
    "on-click-middle": "hyprctl dispatch exit",
    "tooltip": false
  },
  "custom/clipboard": {
    "format": "󰅌",
    "tooltip": false,
    "on-click": "~/.local/bin/cyber-clipboard",
    "on-click-right": "~/.local/bin/cyber-clipboard --wipe"
  }
}