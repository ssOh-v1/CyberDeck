{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 5,
  "margin-left": 14,
  "margin-right": 14,
  "margin-bottom": 0,
  "spacing": 4,
  "exclusive": true,
  "passthrough": false,
  "reload_style_on_change": true,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces"
  ],

  "modules-center": [],

  "modules-right": [
    "custom/media",
    "cpu",
    "memory",
    "backlight",
    "backlight/slider",
    "pulseaudio",
    "pulseaudio/slider",
    "custom/wifi",
    "custom/power-mode",
    "hyprland/language",
    "battery",
    "clock",
    "custom/lock",
    "custom/poweroff"
  ],

  "custom/launcher": {
    "format": "▣",
    "tooltip-format": "ЛКМ: Лаунчер приложений (Rofi)\nПКМ: Системный монитор Btop",
    "on-click": "rofi -show drun -theme ~/.config/hypr/gaming_launcher.rasi",
    "on-click-right": "~/.local/bin/cyber-tool btop"
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "all-outputs": true,
    "sort-by-number": true
  },

  "custom/media": {
    "exec": "~/.local/bin/waybar-media",
    "return-type": "json",
    "interval": 2,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl previous",
    "on-scroll-down": "playerctl next"
  },

  "cpu": {
    "interval": 2,
    "format": "󰻠 {usage}%",
    "tooltip-format": "Нагрузка CPU: {usage}%\nЛКМ — открыть Btop",
    "on-click": "~/.local/bin/cyber-tool btop"
  },

  "memory": {
    "interval": 3,
    "format": "󰍛 {used:0.1f}G",
    "tooltip-format": "ОЗУ: {used:0.1f} GB / {total:0.1f} GB\nПКМ — очистить кэш ОЗУ",
    "on-click": "~/.local/bin/cyber-tool btop",
    "on-click-right": "sudo -n /usr/local/bin/cyber-power-hw purge-ram && notify-send -a cyber-kb '▣ STUDIO' 'Кэш ОЗУ очищен'"
  },

  "backlight": {
    "format": "󰃠 {percent}%",
    "tooltip-format": "Яркость экрана: {percent}% (ЛКМ — 100%/60%)",
    "on-scroll-up": "brightnessctl -q set +5%",
    "on-scroll-down": "brightnessctl -q set 5%-",
    "on-click": "sh -c 'CUR=$(brightnessctl -m | cut -d, -f4 | tr -d \"%\"); [ \"$CUR\" -lt 95 ] && brightnessctl -q set 100% || brightnessctl -q set 60%'"
  },

  "backlight/slider": {
    "min": 5,
    "max": 100,
    "orientation": "horizontal"
  },

  "pulseaudio": {
    "format": "󰕾 {volume}%",
    "format-muted": "󰝟 MUTE",
    "tooltip-format": "Звук: {volume}% (ЛКМ — микшер, ПКМ — Mute)",
    "on-click": "~/.local/bin/cyber-audio-menu",
    "on-click-right": "pamixer -t",
    "on-scroll-up": "pamixer -i 5",
    "on-scroll-down": "pamixer -d 5"
  },

  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },

  "custom/wifi": {
    "exec": "~/.local/bin/waybar-wifi",
    "return-type": "json",
    "interval": 4,
    "on-click": "~/.local/bin/cyber-wifi-menu"
  },

  "custom/power-mode": {
    "exec": "~/.local/bin/waybar-power-mode",
    "return-type": "json",
    "interval": 2,
    "on-click": "~/.local/bin/cyber-power toggle"
  },

  "hyprland/language": {
    "format": "{}",
    "format-en": "EN",
    "format-ru": "RU",
    "tooltip-format": "Сменить раскладку (Alt + Shift)",
    "on-click": "hyprctl switchxkblayout all next"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "󰁹 {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%"
  },

  "clock": {
    "format": "{:%H:%M  •  %d.%m}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },

  "custom/lock": {
    "format": "󰌾",
    "tooltip-format": "Блокировка экрана (SUPER + L)",
    "on-click": "~/.local/bin/cyber-lock"
  },

  "custom/poweroff": {
    "format": "󰐥",
    "tooltip-format": "ЛКМ: Выключить ПК • ПКМ: Перезагрузить • СКМ: Выйти в SDDM",
    "on-click": "systemctl poweroff",
    "on-click-right": "systemctl reboot",
    "on-click-middle": "hyprctl dispatch exit"
  }
}
