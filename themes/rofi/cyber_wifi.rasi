configuration {
    show-icons: false;
}

* {
    bg:          #080b12;
    bg-elev:     #0f1524;
    bg-card:     #0c111d;
    bg-sel:      #17233b;
    fg:          #dce3f5;
    fg-dim:      #677391;
    border-col:  #243252;
    accent:      #22b8cf;

    background-color: transparent;
    text-color: @fg;
    font: "Noto Sans 12";
}

window {
    width: 560px;
    background-color: @bg;
    border: 2px;
    border-color: @border-col;
    border-radius: 14px;
    padding: 18px;
}

mainbox {
    spacing: 12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-elev;
    border: 1px;
    border-color: @border-col;
    border-radius: 10px;
    padding: 9px 13px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    background-color: #132238;
    text-color: #66d9e8;
    padding: 3px 10px;
    border-radius: 6px;
    font: "Noto Sans Bold 10";
}

entry {
    background-color: transparent;
    placeholder: "Фильтр сетей или ввод ключа...";
    placeholder-color: @fg-dim;
    text-color: @fg;
}

listview {
    lines: 9;
    columns: 1;
    spacing: 6px;
    scrollbar: false;
    fixed-height: false;
}

element, element normal.normal, element alternate.normal {
    padding: 9px 13px;
    border-radius: 9px;
    background-color: @bg-card;
    text-color: @fg;
}

element selected.normal {
    background-color: @bg-sel;
    border: 1px;
    border-color: @accent;
    text-color: #f0f4ff;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
