configuration {
    show-icons: false;
}

* {
    bg:          #070a12;
    bg-panel:    #0c1221;
    bg-card:     #0d1323;
    bg-sel:      #14233f;
    fg:          #dce3f5;
    fg-dim:      #6c7a9c;
    border-col:  #253659;
    cyan:        #22b8cf;
    indigo:      #4c6ef5;

    background-color: transparent;
    text-color: @fg;
    font: "Noto Sans 11.5";
}

window {
    width: 640px;
    background-color: @bg;
    border: 2px;
    border-color: @cyan;
    border-radius: 16px;
    padding: 18px;
}

mainbox {
    spacing: 12px;
    children: [ box-header, inputbar, listview, box-footer ];
}

box-header {
    orientation: horizontal;
    expand: false;
    spacing: 10px;
    background-color: @bg-panel;
    border: 1px;
    border-color: @border-col;
    border-radius: 10px;
    padding: 8px 14px;
    children: [ textbox-wtitle, textbox-wtag ];
}

textbox-wtitle {
    expand: true;
    str: "◈ CYBER DECK // WIRELESS RADIO TELEMETRY";
    text-color: #e5ecff;
    font: "Noto Sans Bold 11";
}

textbox-wtag {
    expand: false;
    str: "802.11AX // WPA3";
    background-color: #0e2229;
    text-color: #63e6be;
    border: 1px;
    border-color: #1c4b42;
    border-radius: 6px;
    padding: 2px 9px;
    font: "Noto Sans Bold 9.5";
}

inputbar {
    background-color: @bg-panel;
    border: 1px;
    border-color: @indigo;
    border-radius: 10px;
    padding: 9px 13px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    background-color: #132238;
    text-color: #66d9e8;
    border: 1px;
    border-color: @cyan;
    padding: 3px 10px;
    border-radius: 6px;
    font: "Noto Sans Bold 10";
}

entry {
    placeholder: "Фильтр точек доступа или ввод ключа безопасности...";
    placeholder-color: @fg-dim;
    text-color: #f0f4ff;
    vertical-align: 0.5;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 7px;
    scrollbar: true;
    fixed-height: false;
}

scrollbar {
    width: 5px;
    handle-color: @cyan;
    handle-width: 5px;
    background-color: #101729;
    border-radius: 4px;
}

element, element normal.normal, element alternate.normal {
    padding: 10px 14px;
    border: 1px;
    border-color: #1c2844;
    border-radius: 10px;
    background-color: @bg-card;
    text-color: @fg;
}

element selected.normal {
    background-color: @bg-sel;
    border: 1px;
    border-color: @cyan;
    text-color: #f0f4ff;
}

element-text {
    text-color: inherit;
    font: "Noto Sans Bold 11";
}

box-footer {
    orientation: horizontal;
    expand: false;
    background-color: #0a0f1c;
    border: 1px;
    border-color: #1d2945;
    border-radius: 9px;
    padding: 6px 14px;
    children: [ textbox-wftr, textbox-wnode ];
}

textbox-wftr {
    expand: true;
    str: "[▲/▼] Выбор сети   •   [Enter] Подключить / Переключить   •   [Esc] Выход";
    text-color: #7d89a8;
    font: "Noto Sans Bold 9.5";
}

textbox-wnode {
    expand: false;
    str: "NET // MATRIX";
    text-color: @cyan;
    font: "Noto Sans Bold 9.5";
}
