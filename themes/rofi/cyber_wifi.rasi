configuration {
    show-icons:                 false;
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
}

* {
    bg-main:                    #121316f8;
    bg-header:                  #17191ef8;
    bg-card:                    #181a20ff;
    bg-selected:                #262a33ff;
    bg-input:                   #111215ff;
    fg-main:                    #e6e9efff;
    fg-muted:                   #828894ff;
    border-subtle:              #262930ff;
    border-strong:              #3e434dff;
    accent-silver:              #9ea4b0ff;

    background-color:           transparent;
    text-color:                 @fg-main;
    font:                       "Inter SemiBold 11";
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    width:                      500px;
    background-color:           @bg-main;
    border:                     1px;
    border-color:               @border-strong;
    border-radius:              10px;
    padding:                    0px;
}

mainbox {
    spacing:                    0px;
    padding:                    0px;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    spacing:                    10px;
    padding:                    12px 16px;
    background-color:           @bg-header;
    border:                     0px 0px 1px 0px;
    border-color:               @border-subtle;
    children:                   [ "prompt", "entry" ];
}

prompt {
    background-color:           #22252dff;
    text-color:                 @fg-main;
    padding:                    6px 10px;
    border:                     1px;
    border-color:               @border-strong;
    border-radius:              5px;
    font:                       "JetBrainsMono Nerd Font Bold 10.5";
}

entry {
    background-color:           @bg-input;
    text-color:                 @fg-main;
    placeholder:                "Фильтр списка...";
    placeholder-color:          @fg-muted;
    padding:                    6px 10px;
    border:                     1px;
    border-color:               @border-subtle;
    border-radius:              5px;
}

listview {
    columns:                    1;
    lines:                      8;
    fixed-height:               false;
    scrollbar:                  false;
    spacing:                    6px;
    padding:                    12px 16px;
}

element {
    padding:                    8px 12px;
    border:                     1px;
    border-color:               @border-subtle;
    border-radius:              6px;
    background-color:           @bg-card;
    text-color:                 @fg-main;
}

element normal.normal,
element alternate.normal {
    background-color:           @bg-card;
    text-color:                 @fg-main;
}

element selected.normal {
    background-color:           @bg-selected;
    text-color:                 #ffffffff;
    border:                     1px 1px 1px 3px;
    border-color:               @accent-silver;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    vertical-align:             0.5;
}
