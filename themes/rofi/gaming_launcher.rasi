/*******************************************************************************
 * STUDIO COMMAND PALETTE & 2-COLUMN APP LAUNCHER (ROFI)
 *******************************************************************************/
configuration {
    modi:                       "drun,run,window";
    show-icons:                 true;
    icon-theme:                 "CyberDeck-Icons";
    display-drun:               "▣ ПРИЛОЖЕНИЯ";
    display-run:                "❯ КОМАНДЫ";
    display-window:             "󰘔 ОКНА";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
}

* {
    bg-main:                    #121316f8;
    bg-header:                  #17191ef8;
    bg-card:                    #181a20ff;
    bg-selected:                #262a33ff;
    bg-input:                   #111215ff;
    fg-main:                    #e6e9efff;
    fg-muted:                   #828894ff;
    border-subtle:              #262930ff;
    border-strong:              #3e434dff;
    accent-silver:              #9ea4b0ff;

    background-color:           transparent;
    text-color:                 @fg-main;
    font:                       "Inter SemiBold 11";
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      680px;
    background-color:           @bg-main;
    border:                     1px;
    border-color:               @border-strong;
    border-radius:              10px;
    padding:                    0px;
}

mainbox {
    enabled:                    true;
    spacing:                    0px;
    padding:                    0px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview", "mode-switcher" ];
}

inputbar {
    enabled:                    true;
    spacing:                    12px;
    padding:                    14px 18px;
    background-color:           @bg-header;
    border:                     0px 0px 1px 0px;
    border-color:               @border-subtle;
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    background-color:           #22252dff;
    text-color:                 @fg-main;
    padding:                    7px 12px;
    border:                     1px;
    border-color:               @border-strong;
    border-radius:              6px;
    font:                       "JetBrainsMono Nerd Font Bold 10.5";
}

entry {
    enabled:                    true;
    background-color:           @bg-input;
    text-color:                 @fg-main;
    placeholder:                "Поиск программ, инструментов и команд...";
    placeholder-color:          @fg-muted;
    cursor:                     text;
    padding:                    7px 12px;
    border:                     1px;
    border-color:               @border-subtle;
    border-radius:              6px;
}

listview {
    enabled:                    true;
    columns:                    2;
    lines:                      6;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    8px;
    padding:                    14px 18px;
    background-color:           transparent;
}

element {
    enabled:                    true;
    spacing:                    12px;
    padding:                    9px 12px;
    border:                     1px;
    border-color:               @border-subtle;
    border-radius:              7px;
    background-color:           @bg-card;
    text-color:                 @fg-main;
    cursor:                     pointer;
    orientation:                horizontal;
}

element normal.normal,
element alternate.normal {
    background-color:           @bg-card;
    text-color:                 @fg-main;
}

element selected.normal {
    background-color:           @bg-selected;
    text-color:                 #ffffffff;
    border:                     1px 1px 1px 3px;
    border-color:               @accent-silver;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       28px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  bold;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

mode-switcher {
    enabled:                    true;
    spacing:                    10px;
    padding:                    10px 18px;
    background-color:           @bg-header;
    border:                     1px 0px 0px 0px;
    border-color:               @border-subtle;
}

button {
    padding:                    6px 12px;
    border-radius:              5px;
    background-color:           @bg-card;
    text-color:                 @fg-muted;
    border:                     1px;
    border-color:               @border-subtle;
    cursor:                     pointer;
    font:                       "JetBrainsMono Nerd Font Bold 10";
}

button selected {
    background-color:           @bg-selected;
    text-color:                 @fg-main;
    border:                     1px;
    border-color:               @accent-silver;
}

error-message {
    padding:                    16px;
    background-color:           @bg-main;
    text-color:                 @fg-main;
}
