configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "CyberDeck-Icons";
    display-drun: "◈ APPS";
    drun-display-format: "{name}";
}

* {
    bg:          #070a12;
    bg-panel:    #0c1221;
    bg-card:     #0d1323;
    bg-sel:      #14213d;
    fg:          #dce3f5;
    fg-dim:      #6c7a9c;
    border-col:  #253659;
    cyan:        #22b8cf;
    indigo:      #4c6ef5;

    background-color: transparent;
    text-color: @fg;
    font: "Noto Sans 11.5";
}

window {
    width: 760px;
    background-color: @bg;
    border: 2px;
    border-color: @cyan;
    border-radius: 16px;
    padding: 18px;
}

mainbox {
    spacing: 12px;
    children: [ box-header, inputbar, listview, box-footer ];
}

box-header {
    orientation: horizontal;
    expand: false;
    spacing: 10px;
    background-color: @bg-panel;
    border: 1px;
    border-color: @border-col;
    border-radius: 10px;
    padding: 8px 14px;
    children: [ textbox-hdr-title, textbox-hdr-badge ];
}

textbox-hdr-title {
    expand: true;
    str: "◈ CYBER DECK // APPLICATION MATRIX";
    text-color: #e5ecff;
    font: "Noto Sans Bold 11";
}

textbox-hdr-badge {
    expand: false;
    str: "FREE-WS ENGINE // READY";
    background-color: #102334;
    text-color: #66d9e8;
    border: 1px;
    border-color: #1f5068;
    border-radius: 6px;
    padding: 2px 9px;
    font: "Noto Sans Bold 9.5";
}

inputbar {
    background-color: @bg-panel;
    border: 1px;
    border-color: @indigo;
    border-radius: 10px;
    padding: 10px 14px;
    spacing: 12px;
    children: [ prompt, entry ];
}

prompt {
    background-color: #13233b;
    text-color: #66d9e8;
    border: 1px;
    border-color: @cyan;
    padding: 3px 11px;
    border-radius: 7px;
    font: "Noto Sans Bold 10.5";
}

entry {
    placeholder: "Введите название программы, IDE или системной утилиты...";
    placeholder-color: @fg-dim;
    text-color: #f0f4ff;
    vertical-align: 0.5;
}

listview {
    lines: 6;
    columns: 2;
    spacing: 9px;
    scrollbar: true;
    fixed-height: true;
}

scrollbar {
    width: 5px;
    border: 0;
    handle-color: @cyan;
    handle-width: 5px;
    background-color: #101729;
    border-radius: 4px;
    padding: 0;
}

element, element normal.normal, element alternate.normal {
    padding: 10px 13px;
    spacing: 12px;
    border: 1px;
    border-color: #1c2844;
    border-radius: 10px;
    background-color: @bg-card;
    text-color: @fg;
}

element selected.normal {
    background-color: @bg-sel;
    border: 1px;
    border-color: @cyan;
    text-color: #f0f4ff;
}

element-icon {
    size: 30px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    font: "Noto Sans Bold 11";
}

box-footer {
    orientation: horizontal;
    expand: false;
    background-color: #0a0f1c;
    border: 1px;
    border-color: #1d2945;
    border-radius: 9px;
    padding: 6px 14px;
    children: [ textbox-ftr-hints, textbox-ftr-node ];
}

textbox-ftr-hints {
    expand: true;
    str: "[▲/▼/◄/►] Навигация   •   [Enter] Открыть на свободном столе   •   [Esc] Закрыть";
    text-color: #7d89a8;
    font: "Noto Sans Bold 9.5";
}

textbox-ftr-node {
    expand: false;
    str: "////// HUD_V2";
    text-color: @cyan;
    font: "Noto Sans Bold 9.5";
}
